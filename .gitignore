# Vendored third-party sources. This repository is standalone: everything needed
# for a build is committed, so the binary-extension rules above must not reach
# into these trees - code/libs/win64 is SDL2.dll/.lib for the MSVC projects, and
# the SDL2 tree carries its own prebuilt bits.
!/code/libs/**
!/code/SDL2/**
!/code/libogg/**
!/code/libvorbis/**
misc/msvc/.vs/
misc/msvc/.res
# build output from package-release.sh
release/

# Python bytecode from the tools/
__pycache__/
*.pyc
