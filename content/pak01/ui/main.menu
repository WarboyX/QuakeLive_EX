        itemDef { group grpPhysics  type ITEM_TYPE_MULTI  text ""  cvar "pmove_WeaponDropTime"  cvarFloatList { "0" 0 "100" 100 "200" 200 "300" 300 }  rect 465 90 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

