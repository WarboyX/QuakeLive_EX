                setitemcolor ignav4u backcolor 1 1 1 0
                setitemcolor ignav5u backcolor 1 1 1 0
                setitemcolor ignav6u backcolor 1 1 1 0
                setitemcolor ignav7u backcolor 1 1 1 0
                setitemcolor ignav8u backcolor 1 1 1 0
                open io_ig_vote
            }
