        itemDef { group grpPhysics  type ITEM_TYPE_MULTI  text ""  cvar "pmove_HookPullVelocity"  cvarFloatList { "600" 600 "800" 800 "1000" 1000 "1200" 1200 }  rect 465 110 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpPhysics  text "Step Height:"  textscale .2  rect 310 130 140 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpPhysics  type ITEM_TYPE_MULTI  text ""  cvar "pmove_StepHeight"  cvarFloatList { "18 (QL)" 18 "22 (Q3)" 22 "26" 26 }  rect 465 130 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // ======================================================
