    // =============================================
    // JOIN SERVER (server browser)
    //
    // The browser back end - UI_BuildServerDisplayList, UI_StartServerRefresh,
    // the FEEDER_SERVERS feeder, sorting and favourites - was already
    // implemented in ui_main.c; only this menu was missing, which is why the
    // main menu had no way to reach it.
    //
    // Lives in main.menu rather than its own file on purpose: menus are loaded
    // from ui/menus.txt, and this build does not ship one. Shipping a menus.txt
    // would override Quake Live's and stop its own menus from loading at all.
    // =============================================
    menuDef {
        name "io_joinserver"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.05 0.05 0.08 1

        onOpen {
            close io_createserver ;
            setFocus serverlist ;
            uiScript UpdateFilter
        }
        onESC { uiScript StopRefresh ; close io_joinserver ; open main }

        itemDef {
            name title
            text "JOIN SERVER"
            textscale .35
            style WINDOW_STYLE_EMPTY
            rect 0 18 640 30
            textalign ITEM_ALIGN_CENTER
            textalignx 320
            textaligny 22
            forecolor 1 .75 0 1
            visible 1
            decoration
        }

        // ---- source: local / internet / favorites -------------------------
        itemDef {
            name sourcelabel
            text "Source:"
            textscale .22
            rect 20 52 70 18
            textaligny 14
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            name source
            type ITEM_TYPE_OWNERDRAW
            ownerdraw UI_NETSOURCE
            rect 90 52 130 18
            textscale .22
            textaligny 14
            forecolor 1 1 1 1
            visible 1
            action { play "sound/misc/menu1.wav" ; uiScript RefreshServers }
        }

        // ---- gametype filter ---------------------------------------------
        itemDef {
            name gametypelabel
            text "Game type:"
            textscale .22
            rect 240 52 90 18
            textaligny 14
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            name gametypefilter
            type ITEM_TYPE_OWNERDRAW
            ownerdraw UI_JOINGAMETYPE
            rect 330 52 130 18
            textscale .22
            textaligny 14
            forecolor 1 1 1 1
            visible 1
            action { play "sound/misc/menu1.wav" ; uiScript UpdateFilter }
        }

        // ---- show full / show empty --------------------------------------
        itemDef {
            name showfulllabel
            text "Show full:"
            textscale .2
            rect 480 52 70 18
            textaligny 14
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            name showfull
            type ITEM_TYPE_YESNO
            cvar "ui_browserShowFull"
            rect 552 52 40 18
            textscale .2
            textaligny 14
            textalignx 2
            forecolor 1 1 1 1
            visible 1
            action { uiScript UpdateFilter }
        }
        itemDef {
            name showemptylabel
            text "Show empty:"
            textscale .2
            rect 480 70 70 18
            textaligny 14
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            name showempty
            type ITEM_TYPE_YESNO
            cvar "ui_browserShowEmpty"
            rect 552 70 40 18
            textscale .2
            textaligny 14
            textalignx 2
            forecolor 1 1 1 1
            visible 1
            action { uiScript UpdateFilter }
        }

        // ---- column headers (click to sort) ------------------------------
        // Column order must match UI_FeederItemText's SORT_* cases:
        // 0 host, 1 map, 2 clients, 3 game, 4 ping.
        itemDef {
            name hdrhost  text "Server"  type ITEM_TYPE_BUTTON  textscale .2
            rect 24 92 180 16  textaligny 12  forecolor 1 .75 0 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript ServerSort 0 }
        }
        itemDef {
            name hdrmap  text "Map"  type ITEM_TYPE_BUTTON  textscale .2
            rect 214 92 90 16  textaligny 12  forecolor 1 .75 0 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript ServerSort 1 }
        }
        itemDef {
            name hdrplayers  text "Players"  type ITEM_TYPE_BUTTON  textscale .2
            rect 314 92 70 16  textaligny 12  forecolor 1 .75 0 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript ServerSort 2 }
        }
        itemDef {
            name hdrgame  text "Type"  type ITEM_TYPE_BUTTON  textscale .2
            rect 394 92 90 16  textaligny 12  forecolor 1 .75 0 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript ServerSort 3 }
        }
        itemDef {
            name hdrping  text "Ping"  type ITEM_TYPE_BUTTON  textscale .2
            rect 494 92 50 16  textaligny 12  forecolor 1 .75 0 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript ServerSort 4 }
        }

        // ---- the list ------------------------------------------------------
        itemDef {
            name serverlist
            rect 20 108 600 268
            type ITEM_TYPE_LISTBOX
            style WINDOW_STYLE_EMPTY
            elementwidth 120
            elementheight 14
            elementtype LISTBOX_TEXT
            feeder FEEDER_SERVERS
            textscale .2
            border 1
            bordersize 1
            bordercolor .5 .5 .5 .5
            forecolor 1 1 1 1
            backcolor 0 0 0 .25
            outlinecolor .1 .1 .7 .5
            visible 1
            columns 5   4 190 34   194 100 16   294 70 12   374 90 14   474 50 8
            doubleClick { play "sound/misc/menu1.wav" ; uiScript JoinServer }
        }

        // ---- refresh status --------------------------------------------------
        itemDef {
            name refreshdate
            type ITEM_TYPE_OWNERDRAW
            ownerdraw UI_SERVERREFRESHDATE
            rect 20 380 300 16
            textscale .2
            textaligny 12
            forecolor .8 .8 .8 1
            visible 1
            decoration
        }

        // ---- buttons ---------------------------------------------------------
        itemDef {
            name refresh  text "REFRESH"  type ITEM_TYPE_BUTTON  textscale .25
            rect 20 404 110 24  textaligny 18  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript RefreshServers }
            mouseEnter { setitemcolor refresh forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor refresh forecolor 1 1 1 1 }
        }
        itemDef {
            name stoprefresh  text "STOP"  type ITEM_TYPE_BUTTON  textscale .25
            rect 140 404 90 24  textaligny 18  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript StopRefresh }
            mouseEnter { setitemcolor stoprefresh forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor stoprefresh forecolor 1 1 1 1 }
        }
        itemDef {
            name addfav  text "ADD FAVORITE"  type ITEM_TYPE_BUTTON  textscale .25
            rect 240 404 150 24  textaligny 18  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript addFavorite }
            mouseEnter { setitemcolor addfav forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor addfav forecolor 1 1 1 1 }
        }
        itemDef {
            name delfav  text "DROP FAVORITE"  type ITEM_TYPE_BUTTON  textscale .25
            rect 400 404 160 24  textaligny 18  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript deleteFavorite }
            mouseEnter { setitemcolor delfav forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor delfav forecolor 1 1 1 1 }
        }
        itemDef {
            name join  text "JOIN"  type ITEM_TYPE_BUTTON  textscale .3
            rect 20 436 120 28  textaligny 20  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript JoinServer }
            mouseEnter { setitemcolor join forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor join forecolor 1 1 1 1 }
        }
        itemDef {
            name back  text "BACK"  type ITEM_TYPE_BUTTON  textscale .3
            rect 500 436 120 28  textaligny 20  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript StopRefresh ; close io_joinserver ; open main }
            mouseEnter { setitemcolor back forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor back forecolor 1 1 1 1 }
        }
    }

    // =============================================
    // PLAYER SETUP
    //
    // Reachable anywhere - including mid-match - with:  \menu_open playersetup
    // ui_GetName/ui_SetName are the uiScripts the module already exposes; the
    // edit field is bound to ui_Name and only committed to the real "name" cvar
    // on APPLY, so a half-typed name is never sent to the server.
    // =============================================
    menuDef {
        name "io_playersetup"
        rect 120 120 400 240
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.05 0.05 0.08 1
        border 1
        bordersize 1
        bordercolor .5 .5 .5 1

        onOpen { setFocus namefield }
        onESC { close io_playersetup }

        itemDef {
            name title
            text "PLAYER SETUP"
            textscale .3
            rect 0 10 400 24
            textalign ITEM_ALIGN_CENTER
            textalignx 200
            textaligny 18
            forecolor 1 .75 0 1
            visible 1
            decoration
        }

        itemDef {
            name namelabel
            text "Name:"
            textscale .25
            rect 30 60 80 20
            textaligny 15
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            name namefield
            type ITEM_TYPE_EDITFIELD
            text ""
            // Bound straight to the live cvar rather than to ui_Name and back
            // through ui_GetName / ui_SetName. That round trip left the field
            // showing nothing and never wrote the name through on APPLY.
            cvar "name"
            maxchars 36
            maxpaintchars 22
            rect 110 60 260 20
            textscale .25
            textaligny 15
            textalignx 4
            forecolor 1 1 1 1
            backcolor 0 0 0 .5
            border 1
            bordersize 1
            bordercolor .5 .5 .5 .5
            visible 1
        }

        itemDef {
            name handicaplabel
            text "Handicap:"
            textscale .25
            rect 30 90 80 20
            textaligny 15
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            name handicap
            type ITEM_TYPE_MULTI
            text ""
            cvar "handicap"
            cvarFloatList { "None" 100 "90" 90 "80" 80 "70" 70 "60" 60 "50" 50 "40" 40 "30" 30 "20" 20 "10" 10 }
            rect 110 90 120 20
            textscale .25
            textaligny 15
            textalignx 4
            forecolor 1 1 1 1
            visible 1
        }

        itemDef {
            name hint
            text "Colour codes are supported. The name applies as you type, in match too."
            textscale .18
            rect 30 122 340 18
            textaligny 12
            forecolor .6 .6 .6 1
            visible 1
            decoration
        }

        itemDef {
            name apply  text "APPLY"  type ITEM_TYPE_BUTTON  textscale .28
            rect 30 180 120 26  textaligny 19  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_playersetup }
            mouseEnter { setitemcolor apply forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor apply forecolor 1 1 1 1 }
        }
        itemDef {
            name cancel  text "CANCEL"  type ITEM_TYPE_BUTTON  textscale .28
            rect 250 180 120 26  textaligny 19  textalignx 10
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_playersetup }
            mouseEnter { setitemcolor cancel forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor cancel forecolor 1 1 1 1 }
        }
    }

    // =============================================
    // RENDER OPTIONS
    //
    // Quake Live's own Video Options and Post Process tabs live in its
    // pak00.pk3, which this build does not ship and cannot edit - so the
    // renderer settings added here have nowhere to go in those tabs. This is a
    // self-contained panel for them instead.
    //
    // Reachable anywhere, including mid-match:  \menu_open renderoptions
    // =============================================
    // =============================================
    // RENDER PAGES
    //
    // [QL] R24. Laid out on a fixed row grid, not by hand. Every rect below
    // is derived from a row index: content starts at y=42, the pitch is 21
    // and an item is 18 tall, labels sit at x=24 w=186, controls at x=216,
    // help text spans x=24 w=472, and the footer is at y=434. Rows 0..17 fit.
    //
    // It was not always. Rows were appended as cvars landed and their y values
    // were picked by eye, until two help lines at y=398 and y=414 were drawing
    // straight through the "Lights clear AO" and "Water reflections" rows and
    // APPLY was rendering below its own window border. Nothing said so: the
    // parser has no opinion about geometry and neither did check-menus.py.
    //
    // It does now - it fails on overlapping rects and on anything outside its
    // menuDef frame. Where an overlap is deliberate, say so with a
    // "check-menus: overlap-ok" comment rather than moving the rows apart.
    //
    // Four pages because the renderer keeps gaining controls and one page ran
    // out of rows. If a page fills up, split it; do not shrink the pitch.
    // =============================================

    menuDef {
        name "io_renderoptions"
        rect 60 8 520 468
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.04 0.04 0.07 1
        border 1
        bordersize 1
        bordercolor .45 .45 .5 1

        onESC { close io_renderoptions }

        itemDef { name title  text "RENDER OPTIONS"  textscale .3
                  rect 0 6 520 26  textalign ITEM_ALIGN_CENTER  textalignx 260  textaligny 19
                  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { name titlerule  text ""  rect 24 36 472 1  visible 1  decoration
                  style WINDOW_STYLE_FILLED  backcolor .35 .3 .12 1 }

        // ---- presets ----------------------------------------------------
        itemDef { text "Presets:"  textscale .22  rect 24 42 80 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef {
            name pclassic  text "CLASSIC"  type ITEM_TYPE_BUTTON  textscale .22
            rect 108 39 92 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "exec classic.cfg" }
            mouseEnter { setitemcolor pclassic forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor pclassic forecolor 1 1 1 1 }
        }
        itemDef {
            name pgloss  text "GLOSS"  type ITEM_TYPE_BUTTON  textscale .22
            rect 206 39 92 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "exec gloss.cfg" }
            mouseEnter { setitemcolor pgloss forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor pgloss forecolor 1 1 1 1 }
        }
        itemDef {
            name pvoodoo  text "VOODOO"  type ITEM_TYPE_BUTTON  textscale .22
            rect 304 39 92 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "exec voodoo.cfg" }
            mouseEnter { setitemcolor pvoodoo forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor pvoodoo forecolor 1 1 1 1 }
        }
        itemDef {
            name pmodern  text "DEFAULTS"  type ITEM_TYPE_BUTTON  textscale .22
            rect 402 39 92 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "exec modern.cfg" }
            mouseEnter { setitemcolor pmodern forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor pmodern forecolor 1 1 1 1 }
        }

        itemDef { name "" text "OUTPUT"  textscale .24  rect 20 84 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "Renderer:"  textscale .22  rect 24 105 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name renderer  type ITEM_TYPE_MULTI  text ""  cvar "cl_renderer"
                  cvarStrList { "OpenGL 2", "opengl2", "Vulkan", "vulkan" }  rect 216 105 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Colour depth:"  textscale .22  rect 24 126 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name colorbits  type ITEM_TYPE_MULTI  text ""  cvar "r_colorbits"
                  cvarFloatList { "Driver default" 0 "16-bit (3dfx look)" 16 "10-bit per channel" 30 }  rect 216 126 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Dither:"  textscale .22  rect 24 147 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name dither  type ITEM_TYPE_MULTI  text ""  cvar "r_dither"
                  cvarFloatList { "Off" 0 "Ordered (stable)" 1 "Temporal (best)" 2 }  rect 216 147 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Dither strength follows the framebuffer the driver actually gives you."  textscale .2  rect 24 168 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration }
        itemDef { name "" text "IMAGE"  textscale .24  rect 20 210 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "Antialiasing:"  textscale .22  rect 24 231 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name msaa  type ITEM_TYPE_MULTI  text ""  cvar "r_ext_multisample"
                  cvarFloatList { "Off" 0 "2x MSAA" 2 "4x MSAA" 4 "8x MSAA" 8 }  rect 216 231 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Texture filter:"  textscale .22  rect 24 252 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name texmode  type ITEM_TYPE_MULTI  text ""  cvar "r_textureMode"
                  cvarStrList { "Trilinear", "GL_LINEAR_MIPMAP_LINEAR", "Bilinear", "GL_LINEAR_MIPMAP_NEAREST", "Nearest", "GL_NEAREST" }  rect 216 252 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        // [QL] The action is not decoration. Anisotropy is gated on a second
        // cvar, r_ext_texture_filter_anisotropic, and classic.cfg sets that to
        // 0 on purpose - so on a machine that has ever pressed CLASSIC this
        // control could read 16x and do nothing at all, with the startup line
        // saying "anisotropic filtering disabled". Setting it here turns the
        // gate back on so the row means what it says.
        itemDef { text "Anisotropic filter:"  textscale .22  rect 24 273 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name aniso  type ITEM_TYPE_MULTI  text ""  cvar "r_ext_max_anisotropy"
                  cvarFloatList { "Off" 1 "2x" 2 "4x" 4 "8x" 8 "16x" 16 }
                  rect 216 273 140 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1
                  action { exec "r_ext_texture_filter_anisotropic 1" }
                  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Bloom:"  textscale .22  rect 24 294 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name bloom  type ITEM_TYPE_YESNO  text ""  cvar "r_bloom"  rect 216 294 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Lens flares:"  textscale .22  rect 24 315 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name flares  type ITEM_TYPE_YESNO  text ""  cvar "r_flares"  rect 216 315 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { name "" text "POST PROCESSING"  textscale .24  rect 20 336 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "HDR framebuffer:"  textscale .22  rect 24 357 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { name hdr  type ITEM_TYPE_YESNO  text ""  cvar "r_hdr"  rect 216 357 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { text "Real-time shading:"  textscale .22  rect 24 357 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name rts  type ITEM_TYPE_MULTI  text ""  cvar "r_rts"
                  cvarFloatList { "Off (default)" 0 "On, float target" 1 "On, packed float" 2 }  rect 216 357 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Tonemapping:"  textscale .22  rect 24 378 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { name tonemap  type ITEM_TYPE_YESNO  text ""  cvar "r_toneMap"  rect 216 378 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { text "Post processing:"  textscale .22  rect 24 378 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name postproc  type ITEM_TYPE_YESNO  text ""  cvar "r_postProcess"  rect 216 378 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }

        // ---- sub-pages --------------------------------------------------
        // [QL] Each of these is a page of its own because the renderer keeps
        // gaining controls and this page ran out of rows once already - that
        // is R24, and it is the whole reason for the grid at the top.
        itemDef {
            name pglight  text "LIGHTING >"  type ITEM_TYPE_BUTTON  textscale .22
            rect 24 399 148 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_renderoptions ; open io_raytracing }
            mouseEnter { setitemcolor pglight forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor pglight forecolor 1 1 1 1 }
        }
        itemDef {
            name pgwater  text "WATER >"  type ITEM_TYPE_BUTTON  textscale .22
            rect 182 399 148 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_renderoptions ; open io_water }
            mouseEnter { setitemcolor pgwater forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor pgwater forecolor 1 1 1 1 }
        }
        itemDef {
            name pgsurf  text "SURFACE DETAIL >"  type ITEM_TYPE_BUTTON  textscale .22
            rect 340 399 156 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_renderoptions ; open io_surfacedetail }
            mouseEnter { setitemcolor pgsurf forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor pgsurf forecolor 1 1 1 1 }
        }

        itemDef {
            name apply  text "APPLY (restart video)"  type ITEM_TYPE_BUTTON  textscale .25
            rect 24 434 230 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "vid_restart" }
            mouseEnter { setitemcolor apply forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor apply forecolor 1 1 1 1 }
        }
        itemDef {
            name close  text "CLOSE"  type ITEM_TYPE_BUTTON  textscale .25
            rect 386 434 110 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_renderoptions }
            mouseEnter { setitemcolor close forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor close forecolor 1 1 1 1 }
        }
    }

    menuDef {
        name "io_raytracing"
        rect 60 8 520 468
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.04 0.04 0.07 1
        border 1
        bordersize 1
        bordercolor .45 .45 .5 1

        onESC { close io_raytracing ; open io_renderoptions }

        itemDef { name title  text "LIGHTING & RAY TRACING"  textscale .3
                  rect 0 6 520 26  textalign ITEM_ALIGN_CENTER  textalignx 260  textaligny 19
                  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { name titlerule  text ""  rect 24 36 472 1  visible 1  decoration
                  style WINDOW_STYLE_FILLED  backcolor .35 .3 .12 1 }

        // ---- status -----------------------------------------------------
        // [QL] Two rows, one cvar each, two mutually exclusive variants per
        // row. One line per *outcome* does not work: cvarTest takes a single
        // cvar and "supported but not active" is a condition on two of them,
        // so both lines drew at the same y on a machine that had neither.
        // Split by cvar instead and four items give four readable states.
        itemDef { name "" text "STATUS"  textscale .24  rect 20 42 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "This GPU:"  textscale .22  rect 24 63 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { text "supports ray queries"  textscale .22  rect 216 63 280 18  textaligny 14  forecolor .4 1 .4 1  visible 1  decoration  cvarTest "r_rtAvailable"  showCvar { "1" } }
        itemDef { text "does not support ray queries"  textscale .22  rect 216 63 280 18  textaligny 14  forecolor 1 .4 .4 1  visible 1  decoration  cvarTest "r_rtAvailable"  showCvar { "0" } }
        itemDef { text "This run:"  textscale .22  rect 24 84 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { text "ACTIVE"  textscale .22  rect 216 84 280 18  textaligny 14  forecolor .4 1 .4 1  visible 1  decoration  cvarTest "r_rtActive"  showCvar { "1" } }
        itemDef { text "not active"  textscale .22  rect 216 84 280 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration  cvarTest "r_rtActive"  showCvar { "0" } }
        itemDef { text "If this says not active, turn it on below and APPLY."  textscale .2  rect 24 105 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration  cvarTest "r_rtAvailable"  showCvar { "1" } }
        itemDef { text "Needs acceleration structure, ray query, deferred host operations,"  textscale .2  rect 24 105 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration  cvarTest "r_rtAvailable"  showCvar { "0" } }
        itemDef { text "buffer device address, and a Vulkan 1.1 loader."  textscale .2  rect 24 126 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration  cvarTest "r_rtAvailable"  showCvar { "0" } }
        itemDef { name "" text "DEVICE"  textscale .24  rect 20 168 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "Enable ray query:"  textscale .22  rect 24 189 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name rtenable  type ITEM_TYPE_YESNO  text ""  cvar "r_rt"  rect 216 189 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Latched. Enables the device features and builds the world acceleration"  textscale .2  rect 24 210 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration }
        itemDef { text "structure at map load; no visible change on its own. Needs APPLY."  textscale .2  rect 24 231 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration }

        // ---- ambient occlusion ------------------------------------------
        // [QL] Not gated on r_rtActive: cvarTest takes one cvar and these
        // each need their own. A control that is present but inert until ray
        // query is on is better than one that vanishes with no explanation;
        // the STATUS rows above are what say whether it can work.
        //
        // Lists rather than sliders, because a slider here drew a bar and no
        // number - no way to see the value, no way to tell what a nudge had
        // changed it to, no default marked, no way back. The console still
        // takes any value for anyone who wants one.
        itemDef { name "" text "AMBIENT OCCLUSION"  textscale .24  rect 20 273 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "Ambient occlusion:"  textscale .22  rect 24 294 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name aoenable  type ITEM_TYPE_MULTI  text ""  cvar "r_rtao"
                  cvarFloatList { "Off" 0 "On" 1 "Debug (show occlusion)" 2 }  rect 216 294 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Radius:"  textscale .22  rect 24 315 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name aoradius  type ITEM_TYPE_MULTI  text ""  cvar "r_rtaoRadius"
                  cvarFloatList { "16 (tight creases)" 16 "32" 32 "64 (default)" 64 "128" 128 "256 (wide)" 256 "512" 512 "1024" 1024 "2048" 2048 "4096 (whole rooms)" 4096 }  rect 216 315 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Strength:"  textscale .22  rect 24 336 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name aostrength  type ITEM_TYPE_MULTI  text ""  cvar "r_rtaoIntensity"
                  cvarFloatList { "0.25 (subtle)" 0.25 "0.5" 0.5 "0.8 (default)" 0.8 "1.0 (full)" 1 }  rect 216 336 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        // [QL] "16 (best)" is what this row used to say and it is not a fair
        // description. The trace is full-resolution and the sample count is
        // unrolled into the shader, so cost is width x height x samples ray
        // queries in one draw call - at 4K, 16 rays is 133 million, past what
        // a driver watchdog allows to finish. Labelled by what it costs.
        itemDef { text "Rays per pixel:"  textscale .22  rect 24 357 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name aosamples  type ITEM_TYPE_MULTI  text ""  cvar "r_rtaoSamples"
                  cvarFloatList { "2 (fastest)" 2 "4 (default)" 4 "8 (heavy)" 8 "16 (very heavy)" 16 }  rect 216 357 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Denoise:"  textscale .22  rect 24 378 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name aodenoise  type ITEM_TYPE_MULTI  text ""  cvar "r_rtaoDenoise"
                  cvarFloatList { "Off (raw, grainy)" 0 "On (default)" 1 "Wide (smoothest)" 2 }  rect 216 378 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        // [QL] Occlusion is an ambient term. Where a rocket is the light, the
        // ambient part is small and its contact shadow should stop being
        // drawn - left in it reads as dirt on a lit surface. The area cleared
        // is the light's own falloff, so it matches what the light lit.
        itemDef { text "Lights clear AO:"  textscale .22  rect 24 399 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name aolights  type ITEM_TYPE_MULTI  text ""  cvar "r_rtaoLights"
                  cvarFloatList { "Off" 0 "Half" 0.5 "Full (default)" 1 }  rect 216 399 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }

        itemDef {
            name aodefaults  text "RESET AO"  type ITEM_TYPE_BUTTON  textscale .25
            rect 24 434 130 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "set r_rtao 0 ; set r_rtaoRadius 64 ; set r_rtaoIntensity 0.8 ; set r_rtaoSamples 4 ; set r_rtaoDenoise 1 ; set r_rtaoLights 1" }
            mouseEnter { setitemcolor aodefaults forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor aodefaults forecolor 1 1 1 1 }
        }
        itemDef {
            name apply  text "APPLY (restart video)"  type ITEM_TYPE_BUTTON  textscale .25
            rect 164 434 210 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "vid_restart" }
            mouseEnter { setitemcolor apply forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor apply forecolor 1 1 1 1 }
        }
        itemDef {
            name back  text "BACK"  type ITEM_TYPE_BUTTON  textscale .25
            rect 396 434 100 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_raytracing ; open io_renderoptions }
            mouseEnter { setitemcolor back forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor back forecolor 1 1 1 1 }
        }
    }

    menuDef {
        name "io_water"
        rect 60 8 520 468
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.04 0.04 0.07 1
        border 1
        bordersize 1
        bordercolor .45 .45 .5 1

        onESC { close io_water ; open io_renderoptions }

        itemDef { name title  text "WATER"  textscale .3
                  rect 0 6 520 26  textalign ITEM_ALIGN_CENTER  textalignx 260  textaligny 19
                  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { name titlerule  text ""  rect 24 36 472 1  visible 1  decoration
                  style WINDOW_STYLE_FILLED  backcolor .35 .3 .12 1 }

        // [QL] R19. Screen space: only what is on screen can be reflected, so
        // a wall behind you never appears in the water. The trace fades
        // toward the edges rather than stopping at them, which is where that
        // limitation shows up rather than being pretended away.
        itemDef { name "" text "REFLECTION"  textscale .24  rect 20 42 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "Water reflections:"  textscale .22  rect 24 63 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ssr  type ITEM_TYPE_MULTI  text ""  cvar "r_ssr"
                  cvarFloatList { "Off (default)" 0 "Subtle" 0.35 "Half" 0.5 "Full" 1 }  rect 216 63 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Trace distance:"  textscale .22  rect 24 84 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ssrdist  type ITEM_TYPE_MULTI  text ""  cvar "r_ssrDistance"
                  cvarFloatList { "512 (near)" 512 "1024" 1024 "2048 (default)" 2048 "4096 (far)" 4096 }  rect 216 84 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Trace steps:"  textscale .22  rect 24 105 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ssrsteps  type ITEM_TYPE_MULTI  text ""  cvar "r_ssrSteps"
                  cvarFloatList { "16 (fastest)" 16 "32 (default)" 32 "64" 64 "128 (sharpest)" 128 }  rect 216 105 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Thickness:"  textscale .22  rect 24 126 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ssrthick  type ITEM_TYPE_MULTI  text ""  cvar "r_ssrThickness"
                  cvarFloatList { "4 (thin)" 4 "8 (default)" 8 "16" 16 "32 (forgiving)" 32 }  rect 216 126 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Debug view:"  textscale .22  rect 24 147 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ssrdebug  type ITEM_TYPE_MULTI  text ""  cvar "r_ssrDebug"
                  cvarFloatList { "Off" 0 "1 mask" 1 "2 ray hit" 2 "3 reflection" 3 "4 waves" 4 "5 ripples + foam" 5 }  rect 216 147 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { name "" text "WAVES (WIND CHOP)"  textscale .24  rect 20 168 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        // [QL] The surface never moves a vertex - Quake Live's water is
        // subdivided at map compile time and cannot be retessellated at
        // runtime. What ripples is the normal, and the reflected direction is
        // reflect(V, N), so tilting N is what sells it. Steepness is the true
        // maximum slope, not an arbitrary scale, because the three waves'
        // amplitudes sum to 1.
        itemDef { text "Waves:"  textscale .22  rect 24 189 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name waves  type ITEM_TYPE_YESNO  text ""  cvar "r_waterWaves"  rect 216 189 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Steepness:"  textscale .22  rect 24 210 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name wavesteep  type ITEM_TYPE_MULTI  text ""  cvar "r_waterWaveSteepness"
                  cvarFloatList { "0.02 (glassy)" 0.02 "0.05" 0.05 "0.08 (default)" 0.08 "0.12" 0.12 "0.2 (choppy)" 0.2 }  rect 216 210 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Height:"  textscale .22  rect 24 231 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name waveheight  type ITEM_TYPE_MULTI  text ""  cvar "r_waterWaveHeight"
                  cvarFloatList { "0 (flat)" 0 "1" 1 "2 (default)" 2 "4" 4 "8 (swell)" 8 }  rect 216 231 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Wavelength:"  textscale .22  rect 24 252 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name wavescale  type ITEM_TYPE_MULTI  text ""  cvar "r_waterWaveScale"
                  cvarFloatList { "48 (fine)" 48 "96 (default)" 96 "192" 192 "384 (broad)" 384 }  rect 216 252 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Speed:"  textscale .22  rect 24 273 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name wavespeed  type ITEM_TYPE_MULTI  text ""  cvar "r_waterWaveSpeed"
                  cvarFloatList { "0 (frozen)" 0 "0.5 (slow)" 0.5 "1 (default)" 1 "2 (fast)" 2 }  rect 216 273 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        // [QL] R28. The other half of the water, and the half that had no
        // controls at all until now: what a rocket or a pellet does to it.
        //
        // These are a separate system from the waves above and share no
        // setting with them, which is worth making visible in the menu rather
        // than only true in the code - "the water is too calm" and "the
        // splashes are too small" were both leading people to the WAVES rows,
        // where only the first of them has an answer.
        //
        // Foam lives under this heading and not its own, because foam is
        // driven off impact energy alone: ordinary chop never whitens, only a
        // splash does. It was under a FOAM heading of its own, next to the
        // waves, which put it with the one thing that cannot cause it.
        //
        // Every value here is a MULTIPLIER on what the weapon asked for, so
        // the per-weapon differences survive being scaled and a rocket stays
        // bigger than a shotgun pellet.
        itemDef { name "" text "IMPACTS (SPLASHES)"  textscale .24  rect 20 294 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "Splash size:"  textscale .22  rect 24 315 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ripplesize  type ITEM_TYPE_MULTI  text ""  cvar "r_waterRippleSize"
                  cvarFloatList { "0.5 (small)" 0.5 "1 (default)" 1 "2 (wide)" 2 "4 (huge)" 4 }  rect 216 315 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Splash strength:"  textscale .22  rect 24 336 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name rippleheight  type ITEM_TYPE_MULTI  text ""  cvar "r_waterRippleHeight"
                  cvarFloatList { "0 (none)" 0 "0.5 (soft)" 0.5 "1 (default)" 1 "2 (hard)" 2 "4 (violent)" 4 }  rect 216 336 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Ripple rings:"  textscale .22  rect 24 357 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ripplewaves  type ITEM_TYPE_MULTI  text ""  cvar "r_waterRippleWaves"
                  cvarFloatList { "2 (few, fat)" 2 "5 (default)" 5 "8" 8 "12 (fine)" 12 }  rect 216 357 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Ripple lifetime:"  textscale .22  rect 24 378 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ripplelife  type ITEM_TYPE_MULTI  text ""  cvar "r_waterRippleLife"
                  cvarFloatList { "1 (brief)" 1 "2.2 (default)" 2.2 "4 (slow)" 4 "6 (lingering)" 6 }  rect 216 378 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Foam:"  textscale .22  rect 24 399 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name foam  type ITEM_TYPE_MULTI  text ""  cvar "r_waterFoam"
                  cvarFloatList { "Off" 0 "Subtle" 0.5 "On (default)" 1 "Heavy" 2 }  rect 216 399 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }

        itemDef {
            name resetwater  text "RESET WATER"  type ITEM_TYPE_BUTTON  textscale .25
            rect 24 434 150 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "set r_ssr 0 ; set r_ssrDistance 2048 ; set r_ssrSteps 32 ; set r_ssrThickness 8 ; set r_ssrDebug 0 ; set r_waterWaves 1 ; set r_waterWaveSteepness 0.08 ; set r_waterWaveHeight 2 ; set r_waterWaveScale 96 ; set r_waterWaveSpeed 1 ; set r_waterFoam 1 ; set r_waterRippleSize 1 ; set r_waterRippleHeight 1 ; set r_waterRippleWaves 5 ; set r_waterRippleLife 2.2" }
            mouseEnter { setitemcolor resetwater forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor resetwater forecolor 1 1 1 1 }
        }
        itemDef {
            name back  text "BACK"  type ITEM_TYPE_BUTTON  textscale .25
            rect 396 434 100 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_water ; open io_renderoptions }
            mouseEnter { setitemcolor back forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor back forecolor 1 1 1 1 }
        }
    }

    menuDef {
        name "io_surfacedetail"
        rect 60 8 520 468
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.04 0.04 0.07 1
        border 1
        bordersize 1
        bordercolor .45 .45 .5 1

        onESC { close io_surfacedetail ; open io_renderoptions }

        itemDef { name title  text "SURFACE DETAIL"  textscale .3
                  rect 0 6 520 26  textalign ITEM_ALIGN_CENTER  textalignx 260  textaligny 19
                  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { name titlerule  text ""  rect 24 36 472 1  visible 1  decoration
                  style WINDOW_STYLE_FILLED  backcolor .35 .3 .12 1 }

        itemDef { name "" text "DYNAMIC LIGHTS"  textscale .24  rect 20 42 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration }
        itemDef { text "Dynamic lights:"  textscale .22  rect 24 63 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name dlight  type ITEM_TYPE_MULTI  text ""  cvar "r_dlightMode"
                  cvarFloatList { "Off surfaces" 0 "On surfaces" 1 "With shadows" 2 }  rect 216 63 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "Beam weapon lights:"  textscale .22  rect 24 84 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name beamlights  type ITEM_TYPE_YESNO  text ""  cvar "cg_beamLights"  rect 216 84 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1 }
        itemDef { text "A rail or lightning beam lights the corridor it crosses."  textscale .2  rect 24 105 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration }

        // [QL] R20 Stage A. Derives a normal map from each dynamically lit
        // surface's own texture and perturbs the normal the light pass
        // shades with. A still scene is unchanged: the sunlight on those
        // surfaces is a baked lightmap and this does not touch it.
        //
        // Both are latched because the strength is baked into image bytes at
        // shader-parse time - a change means nothing until the shaders are
        // re-parsed, and latching is the engine saying so rather than the
        // value appearing to take and doing nothing.
        itemDef { name "" text "DERIVED NORMAL MAPS"  textscale .24  rect 20 147 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Normal perturbation:"  textscale .22  rect 24 168 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name qlnm  type ITEM_TYPE_YESNO  text ""  cvar "r_qlNormalMaps"  rect 216 168 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Strength:"  textscale .22  rect 24 189 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name qlnmscale  type ITEM_TYPE_MULTI  text ""  cvar "r_qlNormalScale"
                  cvarFloatList { "0.25 (subtle)" 0.25 "0.5 (default)" 0.5 "1.0" 1 "1.5" 1.5 "2.0 (hard)" 2 }  rect 216 189 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Max edge tilt:"  textscale .22  rect 24 210 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name qlnmtilt  type ITEM_TYPE_MULTI  text ""  cvar "r_qlNormalMaxTilt"
                  cvarFloatList { "8 (flattest)" 8 "12" 12 "15 (default)" 15 "22" 22 "30 (bands on grazing light)" 30 }  rect 216 210 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Strength shapes gradients, max tilt caps painted edges. Both latched - APPLY."  textscale .2  rect 24 231 472 16  textaligny 13  forecolor .62 .62 .62 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }

        // [QL] R25. Authored normal maps under STATIC light. Needs a map
        // compiled with q3map2 -deluxe: a lightmap says how much light
        // reached a texel and not which way it came from, so without the
        // deluxemap there is nothing for a normal to be dotted against and
        // no normal map changes a still scene at all. Quake Live's own maps
        // carry none and never can, so this is our maps only.
        //
        // Live, not latched - both are specialization constants, so a change
        // allocates a pipeline and takes effect at once.
        itemDef { name "" text "STATIC BUMP (deluxemaps)"  textscale .24  rect 20 273 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Deluxemap shading:"  textscale .22  rect 24 294 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name dlx  type ITEM_TYPE_MULTI  text ""  cvar "r_deluxeMapping"
                  cvarFloatList { "Off" 0 "On (default)" 1 "Debug: light direction" 2 "Debug: perturbed normal" 3 "Debug: modulation only" 4 "Debug: the normal map itself" 5 "Debug: parallax offset" 6 }  rect 216 294 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Static bump strength:"  textscale .22  rect 24 315 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name dlxscale  type ITEM_TYPE_MULTI  text ""  cvar "r_qlBumpScale"
                  cvarFloatList { "0.25 (subtle)" 0.25 "0.5" 0.5 "0.75" 0.75 "1.0 (default)" 1 }  rect 216 315 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        // [QL] The two that make a normal map read as depth rather than as
        // paint, and neither is its strength. Parallax marches the view ray
        // through the height in the map's alpha, so a brick hides the mortar
        // behind it - self-occlusion a normal map structurally cannot do.
        // Specular is a highlight that MOVES with the view, which a lightmap
        // baked from someone else's viewpoint can never produce.
        itemDef { text "Parallax depth:"  textscale .22  rect 24 336 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name plx  type ITEM_TYPE_MULTI  text ""  cvar "r_qlParallax"
                  cvarFloatList { "Off" 0 "0.02 (shallow)" 0.02 "0.04 (default)" 0.04 "0.08" 0.08 "0.12 (deep)" 0.12 }  rect 216 336 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { text "Bump specular:"  textscale .22  rect 24 357 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name bspec  type ITEM_TYPE_MULTI  text ""  cvar "r_qlBumpSpecular"
                  cvarFloatList { "Off" 0 "0.25" 0.25 "0.5 (default)" 0.5 "1.0" 1 "2.0 (wet)" 2 }  rect 216 357 180 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        // [QL] R27. Stochastic hex-tiling - the same idea as Minecraft's
        // "natural textures", done the way a continuous surface needs it.
        // One row, not three: r_qlNaturalRotate and r_qlNaturalContrast are
        // tuning knobs for whoever is looking at the screen, and a menu entry
        // for each would be two more things nobody touches. Latched, because
        // the generic pipelines are built once at map load.
        //
        // "Force on all" is deliberately labelled as debug. It hex-tiles every
        // world diffuse stage, which costs three texture fetches per surface
        // and wrecks anything with structure in it - a sign becomes three
        // overlapping signs.
        itemDef { text "Natural textures:"  textscale .22  rect 24 378 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  showCvar { "vulkan" } }
        itemDef { name nattex  type ITEM_TYPE_MULTI  text ""  cvar "r_qlNaturalTextures"
                  cvarFloatList { "Off" 0 "Shaders that ask (default)" 1 "Debug: force on all" 2 }  rect 216 378 280 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  showCvar { "vulkan" } }

        // [QL] renderergl2 material maps. Vulkan has no consumer for these,
        // so they are hidden there rather than offered and ignored.
        itemDef { name "" text "MATERIAL MAPS"  textscale .24  rect 20 294 300 18  textaligny 14  forecolor 1 .75 0 1  visible 1  decoration  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { text "Cubemap reflections:"  textscale .22  rect 24 315 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { name cubemap  type ITEM_TYPE_YESNO  text ""  cvar "r_cubeMapping"  rect 216 315 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { text "Cubemap size:"  textscale .22  rect 24 336 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { name cubesize  type ITEM_TYPE_MULTI  text ""  cvar "r_cubemapSize"
                  cvarFloatList { "64" 64 "128" 128 "256" 256 "512" 512 }  rect 216 336 140 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { text "Specular mapping:"  textscale .22  rect 24 357 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { name specular  type ITEM_TYPE_YESNO  text ""  cvar "r_specularMapping"  rect 216 357 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { text "Normal mapping:"  textscale .22  rect 24 378 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration  cvarTest "cl_renderer"  hideCvar { "vulkan" } }
        itemDef { name normalmap  type ITEM_TYPE_YESNO  text ""  cvar "r_normalMapping"  rect 216 378 70 18  textscale .22  textaligny 14  textalignx 2  forecolor 1 1 1 1  visible 1  cvarTest "cl_renderer"  hideCvar { "vulkan" } }

        itemDef { text "Ambient light scale:"  textscale .22  rect 24 399 186 18  textaligny 14  forecolor .8 .8 .8 1  visible 1  decoration }
        itemDef { name ambient  type ITEM_TYPE_SLIDER  text ""  cvarFloat "r_ambientScale" 0.6 0 2
                  rect 216 399 180 18  textscale .22  textaligny 14  forecolor 1 1 1 1  visible 1 }

        itemDef {
            name apply  text "APPLY (restart video)"  type ITEM_TYPE_BUTTON  textscale .25
            rect 24 434 230 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; exec "vid_restart" }
            mouseEnter { setitemcolor apply forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor apply forecolor 1 1 1 1 }
        }
        itemDef {
            name back  text "BACK"  type ITEM_TYPE_BUTTON  textscale .25
            rect 396 434 100 26  textaligny 19  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; close io_surfacedetail ; open io_renderoptions }
            mouseEnter { setitemcolor back forecolor 1 .75 0 1 }
            mouseExit  { setitemcolor back forecolor 1 1 1 1 }
        }
    }

