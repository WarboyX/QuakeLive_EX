    menuDef {
        name "io_ig_match"
        rect 40 99 560 292
        visible MENU_FALSE
        fullScreen 0
        style WINDOW_STYLE_EMPTY
        focusColor 0.964 0.815 0 1

        // Pages never handle ESC themselves. The frame owns it, so one key
        // closes the whole menu from any tab instead of walking back a level.
        onESC { uiScript closeingame }

        itemDef { name pgtitle  text "CURRENT MATCH"  textscale .26  rect 20 0 520 24  textaligny 17
                  forecolor 0.964 0.815 0 1  visible 1  decoration }
        itemDef { name pgrule  text ""  rect 20 24 520 1  style WINDOW_STYLE_FILLED
                  backcolor .35 .3 .12 1  visible 1  decoration }
        itemDef { text "Who is here, and which side you are on."  textscale .19  rect 20 26 520 16  textaligny 12
                  forecolor .72 .72 .72 1  visible 1  decoration }
        itemDef { text "Players in this match"  textscale .21  rect 20 44 250 16  textaligny 12
                  forecolor 1 1 1 1  visible 1  decoration }
        itemDef {
            name ig_players  rect 20 64 260 190  type ITEM_TYPE_LISTBOX
            style WINDOW_STYLE_EMPTY  elementwidth 260  elementheight 16
            elementtype LISTBOX_TEXT  feeder FEEDER_PLAYER_LIST
