        itemDef { name ignav2o  rect 72 64 66 17  style WINDOW_STYLE_FILLED  visible 1  decoration
                  backcolor 1 1 1 0 }
        itemDef { name ignav2u  rect 72 80 66 1  style WINDOW_STYLE_FILLED  visible 1  decoration
                  backcolor 1 1 1 0 }
        itemDef { name ignav2t  rect 70 64 70 16  text "Call Vote"  textscale .18
                  style WINDOW_STYLE_EMPTY  textalign ITEM_ALIGN_CENTER  textalignx 35  textaligny 13
                  forecolor 1 1 1 1  visible 1  decoration }

