#include "ui/menudef.h"

// Menu names here carry an io_ prefix. Menus_FindByName returns the first match,
// and Quake Live's own paks define menus called createserver, joinserver and
// playersetup as well - so "open joinserver" could activate ours while
// "close joinserver" closed theirs, or the reverse. Both stayed visible, and
// since both are fullScreen and Q3 paints every visible menu rather than only
// the topmost, they drew on top of each other: doubled headers, overlapping
// labels, two sets of BACK buttons.
//
// main is left unprefixed deliberately: this file replaces ui/main.menu in the
// search path, so Quake Live's own main never loads and cannot collide.

{
    assetGlobalDef {
        font            "fonts/font" 16
        smallFont       "fonts/smallfont" 12
        bigFont         "fonts/bigfont" 20
        cursor          "ui/assets/3_cursor3"
        gradientBar     "ui/assets/gradientbar2.tga"
        itemFocusSound  "sound/misc/menu2.wav"
        fadeClamp       1.0
        fadeCycle       1
        fadeAmount      0.1
        shadowColor     0.1 0.1 0.1 0.25
    }

    // =============================================
    // [QL] E108/E110. Our in-game menu, replacing Quake Live's.
    //
    // WHY IT EXISTS. Everything this port adds lives in main.menu and is
    // reached from the main menu's RENDER entry. In a game, ESC calls
    // _UI_SetActiveMenu(UIMENU_INGAME), which opened Quake Live's own "ingame"
    // - and that menu's nav has no entry that could reach ours, nor any way to
    // be given one: ingame.menu and ingame_lowernav.menu are in pak00, which is
    // read-only to us. The menus were loaded the whole time (_UI_Init loads
    // menus.txt AND ingame.txt); there was simply no button.
    //
    // Replacing rather than extending also costs less than it sounds. Two of
    // Quake Live's seven in-game nav entries, "Settings" and "Main Menu", run
    // `web_changeHash` - they drive the Steam client's web overlay, so there is
    // no native panel behind either. E110 supplies the ones that were real:
    // current match, call vote, admin, add bot, controls, settings, advanced.
    //
    // DEFINED FIRST, AND THAT IS LOAD-BEARING. Menu_PaintAll walks Menus[] in
    // index order and paints every visible menu, so draw order is DEFINITION
    // order - not activation order, and not a stack. Defined next to the render
    // menus, the frame painted ON TOP of the page it had just opened. First in
    // the file means every other menu paints over it, which is what a frame
    // wants: its pages are defined after it, and io_renderoptions and friends
    // open over the whole thing.
    //
    // It also has to sit ABOVE the MAIN TITLE SCREEN banner rather than just
    // before main's menuDef, because main's `check-menus: overlap-ok` waiver is
    // matched positionally - inserting between the comment and the menuDef it
    // waives orphaned it and turned 18 deliberate overlaps into 18 problems.
    //
    // THE BLOCK BELOW IS GENERATED - tools/gen-ingame-menu.py. Edit that, not
    // this, and run tools/check-menus.py afterwards. The tab bar alone is four
    // itemDefs per tab plus a 24-line recolour in every tab's action; by hand
    // that is where a tab ends up highlighting its neighbour.
    // =============================================

    // >>> GENERATED io_ingame BEGIN - tools/gen-ingame-menu.py
    // [QL] E110. The frame: dimmed backdrop, Quake Live's header and logo, the
    // nav bar, and the content panel every page draws inside.
    //
    // THE ART IS QUAKE LIVE'S, BY NAME ONLY. header.tga, ql_logo.tga and
    // content_background.tga are loaded out of the player's own pak00 - the
    // same arrangement as the shader overrides in ql_enhanced.shader. Nothing
    // is copied and nothing is shipped; checked against docs/pak-manifest.txt
    // before being written here, because RE_RegisterShaderNoMip returns 0 for a
    // name the pak does not have and draws nothing while reporting nothing.
    //
    // The geometry is Quake Live's too - rect 40 0 560 480, header 64 tall, nav
    // bar at 63, content panel at 82 - so this reads as the game's own menu
    // rather than as a mod's panel sitting on top of it.
    //
    // check-menus: overlap-ok - this frame is layered by design. The dimming
    // backdrop sits under everything and deliberately overhangs the frame, the
    // logo overhangs it to the left the way Quake Live's does, and each tab is
    // four items sharing one rect. Per-item waivers would be forty copies of
    // this sentence. Kept against the menuDef because the waiver is matched
    // positionally and drifts out of range if it moves up into the notes above.
    menuDef {
        name "io_ingame"
        rect 40 0 560 480
        visible MENU_FALSE
        fullScreen 0
        style WINDOW_STYLE_EMPTY
        focusColor 0.964 0.815 0 1
        disableColor .5 .5 .5 1

        onESC { uiScript closeingame }

        itemDef { name ig_dim  rect -220 0 1080 480  style WINDOW_STYLE_FILLED  visible 1  decoration
                  backcolor 0 0 0 0.55 }
        itemDef { name ig_header  rect 0 0 560 64  background "ui/assets/main_menu/header.tga"
                  style WINDOW_STYLE_FILLED  visible 1  decoration  backcolor 1 1 1 1
                  border 1  bordercolor 0 0 0 0.5 }
        itemDef { name ig_logo  rect -20 0 256 64  background "ui/assets/main_menu/ql_logo.tga"
                  style WINDOW_STYLE_FILLED  visible 1  decoration  backcolor 1 1 1 1 }
        itemDef { name ig_bar  rect 0 63 560 18  style WINDOW_STYLE_FILLED  visible 1  decoration
                  backcolor 0 0 0 0.75  border 1  bordercolor 0 0 0 0.5 }
        itemDef { name ig_page  rect 0 82 560 310
                  background "ui/assets/main_menu/content_background.tga"
                  style WINDOW_STYLE_FILLED  visible 1  decoration
                  forecolor 1 1 1 1  backcolor 1 1 1 1  border 1  bordercolor 0 0 0 0.5 }

        // RESUME, bottom right of the frame. ESC does the same thing; this is
        // for the player who is looking for a button rather than a key.
        itemDef {
            name ig_resume  text "RESUME"  type ITEM_TYPE_BUTTON  textscale .25
            rect 420 400 120 26  textalign ITEM_ALIGN_CENTER  textalignx 60  textaligny 19
            forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript closeingame }
            mouseEnter { setitemcolor ig_resume forecolor 0.964 0.815 0 1 }
            mouseExit  { setitemcolor ig_resume forecolor 1 1 1 1 }
        }

        // --- tab 1: Current Match ---
        itemDef {
            name ignav1
            rect 0 64 70 16
            style WINDOW_STYLE_FILLED
            visible 1
            type ITEM_TYPE_BUTTON
            action {
                play "sound/misc/menu1.wav"
                close io_ig_vote
                close io_ig_admin
                close io_ig_addbot
                close io_ig_controls
                close io_ig_settings
                close io_ig_advanced
                close io_ig_leave
                setitemcolor ignav1t forecolor 0.964 0.815 0 1
                setitemcolor ignav2t forecolor 1 1 1 1
                setitemcolor ignav3t forecolor 1 1 1 1
                setitemcolor ignav4t forecolor 1 1 1 1
                setitemcolor ignav5t forecolor 1 1 1 1
                setitemcolor ignav6t forecolor 1 1 1 1
                setitemcolor ignav7t forecolor 1 1 1 1
                setitemcolor ignav8t forecolor 1 1 1 1
                setitemcolor ignav1o backcolor 0 0 0 0.9
                setitemcolor ignav2o backcolor 1 1 1 0
                setitemcolor ignav3o backcolor 1 1 1 0
                setitemcolor ignav4o backcolor 1 1 1 0
                setitemcolor ignav5o backcolor 1 1 1 0
                setitemcolor ignav6o backcolor 1 1 1 0
                setitemcolor ignav7o backcolor 1 1 1 0
                setitemcolor ignav8o backcolor 1 1 1 0
                setitemcolor ignav1u backcolor 0.964 0.815 0 1
                setitemcolor ignav2u backcolor 1 1 1 0
                setitemcolor ignav3u backcolor 1 1 1 0
                setitemcolor ignav4u backcolor 1 1 1 0
                setitemcolor ignav5u backcolor 1 1 1 0
                setitemcolor ignav6u backcolor 1 1 1 0
                setitemcolor ignav7u backcolor 1 1 1 0
                setitemcolor ignav8u backcolor 1 1 1 0
                open io_ig_match
            }
        }
        itemDef { name ignav1o  rect 2 64 66 17  style WINDOW_STYLE_FILLED  visible 1  decoration
                  backcolor 0 0 0 0.9 }
        itemDef { name ignav1u  rect 2 80 66 1  style WINDOW_STYLE_FILLED  visible 1  decoration
                  backcolor 0.964 0.815 0 1 }
        itemDef { name ignav1t  rect 0 64 70 16  text "Current Match"  textscale .18
                  style WINDOW_STYLE_EMPTY  textalign ITEM_ALIGN_CENTER  textalignx 35  textaligny 13
                  forecolor 0.964 0.815 0 1  visible 1  decoration }

        // --- tab 2: Call Vote ---
        itemDef {
