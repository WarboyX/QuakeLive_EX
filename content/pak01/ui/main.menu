        itemDef { group grpWeapons  text "Shotgun:"  textscale .2  rect 20 155 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_sg"  cvarFloatList { "5" 5 "10" 10 "25" 25 "50" 50 "999" 999 }  rect 130 155 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpWeapons  text "Grenade:"  textscale .2  rect 20 175 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_gl"  cvarFloatList { "5" 5 "10" 10 "25" 25 "50" 50 "999" 999 }  rect 130 175 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpWeapons  text "Rocket:"  textscale .2  rect 20 195 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_rl"  cvarFloatList { "3" 3 "5" 5 "10" 10 "25" 25 "999" 999 }  rect 130 195 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpWeapons  text "Lightning:"  textscale .2  rect 20 215 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_lg"  cvarFloatList { "50" 50 "100" 100 "150" 150 "200" 200 "999" 999 }  rect 130 215 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpWeapons  text "Railgun:"  textscale .2  rect 20 235 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_rg"  cvarFloatList { "3" 3 "5" 5 "10" 10 "25" 25 "999" 999 }  rect 130 235 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpWeapons  text "Plasma:"  textscale .2  rect 20 255 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_pg"  cvarFloatList { "25" 25 "50" 50 "100" 100 "150" 150 "999" 999 }  rect 130 255 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // -- Right column --
