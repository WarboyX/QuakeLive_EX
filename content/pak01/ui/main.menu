    menuDef {
        name "io_ig_leave"
        rect 40 99 560 292
        visible MENU_FALSE
        fullScreen 0
        style WINDOW_STYLE_EMPTY
        focusColor 0.964 0.815 0 1

        // Pages never handle ESC themselves. The frame owns it, so one key
        // closes the whole menu from any tab instead of walking back a level.
        onESC { uiScript closeingame }

        itemDef { name pgtitle  text "LEAVE MATCH"  textscale .26  rect 20 0 520 24  textaligny 17
                  forecolor 0.964 0.815 0 1  visible 1  decoration }
        itemDef { name pgrule  text ""  rect 20 24 520 1  style WINDOW_STYLE_FILLED
                  backcolor .35 .3 .12 1  visible 1  decoration }
        itemDef { text "This one asks first."  textscale .19  rect 20 26 520 16  textaligny 12
                  forecolor .72 .72 .72 1  visible 1  decoration }
        itemDef { text "Leaving drops you back to the main menu. If this is a server you"  textscale .21  rect 24 60 500 16  textaligny 12
                  forecolor 1 1 1 1  visible 1  decoration }
        itemDef { text "joined, you will have to find it again to come back."  textscale .21  rect 24 82 500 16  textaligny 12
                  forecolor 1 1 1 1  visible 1  decoration }
        itemDef {
            name ig_leaveyes  text "LEAVE MATCH"  type ITEM_TYPE_BUTTON  textscale .22
            rect 24 130 220 24  textaligny 17  textalignx 8  forecolor .85 .55 .55 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript Leave }
            mouseEnter { setitemcolor ig_leaveyes forecolor 1 .4 .4 1 }
            mouseExit  { setitemcolor ig_leaveyes forecolor .85 .55 .55 1 }
        }
        itemDef {
            name ig_leaveno  text "STAY"  type ITEM_TYPE_BUTTON  textscale .22
            rect 264 130 220 24  textaligny 17  textalignx 8  forecolor 1 1 1 1  visible 1
            action { play "sound/misc/menu1.wav" ; uiScript closeingame }
            mouseEnter { setitemcolor ig_leaveno forecolor 0.964 0.815 0 1 }
            mouseExit  { setitemcolor ig_leaveno forecolor 1 1 1 1 }
        }
    }
    // <<< GENERATED io_ingame END

    // =============================================
    // MAIN TITLE SCREEN
    // =============================================
    // check-menus: overlap-ok - this page is layered on purpose. Every button
    // is drawn over its own highlight bar, and fadebox covers the lot during
    // the transition, so overlapping rects here are the design and not a
    // collision. The render pages below get no such waiver.
    menuDef {
        name "main"
        background "ui/assets/backscreen_smoke"
        backgroundSize 0 0 1920 1080
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_TRUE
        focusColor 1 .75 0 1

        onOpen {
            // Both createserver and joinserver are fullScreen, and Q3's menu
            // system paints every visible menu rather than just the top one -
            // so one left open behind another shows through it, headers and
            // all. Closing them here means returning to main always clears
            // whatever was underneath.
            close io_createserver ;
            close io_joinserver ;
            // OPTIONS and DEMOS hide this group on the way out. Nothing used to
            // bring it back, so returning to main left the background painted
            // with no buttons on it.
            show mainnav ;
            setitemcolor fadebox backcolor 0 0 0 1 ;
            fadeout fadebox ;
            uiScript stopRefresh ;
            uiScript loadGameInfo
        }

        onESC {
            open quit_popmenu
        }

        // RENDER
        itemDef {
            name renderbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 400 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name renderbtn
            group mainnav
            text "RENDER"
            type 1
            textstyle 6
            rect 0 400 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { open io_renderoptions }
            mouseEnter { setitemcolor renderbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor renderbar backcolor 0.5 0.1 0 .25 }
        }

        // JOIN SERVER
        itemDef {
            name joinbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 200 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name joinserverbtn
            group mainnav
            text "JOIN SERVER"
            type 1
            textstyle 6
            rect 0 200 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { close io_createserver ; close main ; open io_joinserver }
            mouseEnter { setitemcolor joinbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor joinbar backcolor 0.5 0.1 0 .25 }
        }

        // NEW GAME
        itemDef {
            name browserbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 240 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name browser
            group mainnav
            text "NEW GAME"
            type 1
            textstyle 6
            rect 0 240 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { close io_joinserver ; close main ; open io_createserver }
            mouseEnter { setitemcolor browserbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor browserbar backcolor 0.5 0.1 0 .25 }
        }

        // DEMOS
        itemDef {
            name demobar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 280 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name demos
            group mainnav
            text "DEMOS"
            type 1
            textstyle 6
            rect 0 280 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { hide mainnav ; open demo }
            mouseEnter { setitemcolor demobar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor demobar backcolor 0.5 0.1 0 .25 }
        }

        // OPTIONS
        itemDef {
            name optionsbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 320 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name options
            group mainnav
            text "OPTIONS"
            type 1
            textstyle 6
            rect 0 320 320 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { hide mainnav ; open main_options ; open ingame_controls }
            mouseEnter { setitemcolor optionsbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor optionsbar backcolor 0.5 0.1 0 .25 }
        }

        // PLAYER
        itemDef {
            name playerbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 360 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name playerbtn
            group mainnav
            text "PLAYER"
            type 1
            textstyle 6
            rect 0 360 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { open io_playersetup }
            mouseEnter { setitemcolor playerbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor playerbar backcolor 0.5 0.1 0 .25 }
        }

        // CREDITS
        itemDef {
            name creditsbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect 485 360 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name creditsbtn
            group mainnav
            text "CREDITS"
            type 1
            textstyle 6
            rect 485 360 320 30
            textalignx 95
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { open io_credits }
            mouseEnter { setitemcolor creditsbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor creditsbar backcolor 0.5 0.1 0 .25 }
        }

        // QUIT
        itemDef {
            name quitbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect 485 400 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name quit
            group mainnav
            text "QUIT"
            type 1
            textstyle 6
            rect 485 400 320 30
            textalignx 95
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { open quit_popmenu }
            mouseEnter { setitemcolor quitbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor quitbar backcolor 0.5 0.1 0 .25 }
        }

        // CREDITS
        itemDef {
            name pakstamp
            text "pak01 @@PAKSTAMP@@"
            textscale .2
            // textalignx is relative to the item rect - Item_SetTextExtents
            // computes textRect.x from it and then ToWindowCoords adds rect.x on
            // top. 632 was written as if it were a screen coordinate, so the
            // stamp painted at 340 + 632 - width, off the right of the screen.
            rect 340 4 296 12
            textalign ITEM_ALIGN_RIGHT
            textalignx 292
            textaligny 9
            forecolor .45 .45 .45 1
            visible 1
            decoration
        }

        // Build of iobin.pk3 (cgame/qagame/ui), published by the ui module at
        // init as ui_iobinBuild. No "text" here on purpose: Item_Text_Paint
        // falls through to the cvar when item->text is NULL, which is what makes
        // this show the running module's own build rather than a baked string.
        itemDef {
            name iobinstamp
            cvar "ui_iobinBuild"
            textscale .2
            rect 340 16 296 12
            textalign ITEM_ALIGN_RIGHT
            textalignx 292
            textaligny 9
            forecolor .45 .45 .45 1
            visible 1
            decoration
        }

        itemDef {
            name copyright
            text "Quake Live (tm) Copyright 2015 Id Software LLC, a ZeniMax Media company. All Rights Reserved."
            textscale .25
            rect 0 440 640 40
            textalign ITEM_ALIGN_CENTER
            textaligny 32
            textalignx 320
            forecolor .75 0 0 .75
            visible 1
            decoration
        }

        // check-menus: overlap-ok - this is a fade drawn over the whole page,
        // so covering everything under it is the entire point.
        itemDef {
            name fadebox
            style WINDOW_STYLE_FILLED
            background "ui/assets/fadebox.tga"
            forecolor 0 0 0 1
            backcolor 0 0 0 1
            rect 0 0 640 480
            visible 1
            decoration
        }
    }

    // =============================================
    // CREATE SERVER
    // =============================================
    menuDef {
        name "io_createserver"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.05 0.05 0.08 1

        onOpen {
            // io_joinserver closes this one when it opens; without the mirror
            // image, JOIN SERVER then back then NEW GAME left both open and
            // both painting - two fullScreen menus on top of each other.
            uiScript StopRefresh ;
            close io_joinserver ;
            uiScript loadArenas
        }
        onESC { close io_joinserver ; close io_createserver ; open main }

        // ---- TITLE BAR ----
        itemDef {
            style WINDOW_STYLE_FILLED
            rect 0 0 640 22
            backcolor 0.5 0.1 0 0.6
            visible 1
            decoration
        }

        // ---- TAB BUTTONS ----
        itemDef {
            name tab_map
            text "Map"
            type 1
            textscale .22
            rect 10 26 75 18
            textalign ITEM_ALIGN_CENTER
            textalignx 37
            textaligny 14
            forecolor 1 1 1 1
            visible 1
            action {
                hide grpRules ;
                hide grpPhysics ;
                hide grpWeapons ;
                show grpMapSelect
            }
