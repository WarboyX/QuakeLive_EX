            type 1
            textscale .28
            textstyle 6
            rect 390 452 100 24
            textalign ITEM_ALIGN_CENTER
            textalignx 50
            textaligny 19
            forecolor 1 1 1 1
            visible 1
            action { close io_createserver ; open main }
            mouseEnter { setitemcolor backbtn forecolor 1 .75 0 1 }
            mouseExit { setitemcolor backbtn forecolor 1 1 1 1 }
        }

        // ======================================================
        // TAB: MAP SELECT
        // ======================================================

        // Gametype label
        itemDef {
            group grpMapSelect
            text "Game Type:"
            textscale .2
            rect 10 50 80 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        // Gametype selector
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_MULTI
            text ""
            cvar "ui_netGameType"
            cvarFloatList { "Free For All" 0 "Duel" 1 "Race" 2 "Team DM" 3 "Clan Arena" 4 "CTF" 5 "1-Flag CTF" 6 "Overload" 7 "Harvester" 8 "Freeze Tag" 9 "Domination" 10 "Attack/Defend" 11 "Red Rover" 12 }
            rect 90 50 150 15
            textaligny 12
            textalignx 2
            textscale .2
