#include "ui/menudef.h"

// Menu names here carry an io_ prefix. Menus_FindByName returns the first match,
// and Quake Live's own paks define menus called createserver, joinserver and
// playersetup as well - so "open joinserver" could activate ours while
// "close joinserver" closed theirs, or the reverse. Both stayed visible, and
// since both are fullScreen and Q3 paints every visible menu rather than only
// the topmost, they drew on top of each other: doubled headers, overlapping
// labels, two sets of BACK buttons.
//
// main is left unprefixed deliberately: this file replaces ui/main.menu in the
// search path, so Quake Live's own main never loads and cannot collide.

{
    assetGlobalDef {
        font            "fonts/font" 16
        smallFont       "fonts/smallfont" 12
        bigFont         "fonts/bigfont" 20
        cursor          "ui/assets/3_cursor3"
        gradientBar     "ui/assets/gradientbar2.tga"
        itemFocusSound  "sound/misc/menu2.wav"
        fadeClamp       1.0
        fadeCycle       1
        fadeAmount      0.1
        shadowColor     0.1 0.1 0.1 0.25
    }

    // =============================================
    // MAIN TITLE SCREEN
    // =============================================
    menuDef {
        name "main"
        background "ui/assets/backscreen_smoke"
        backgroundSize 0 0 1920 1080
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_TRUE
        focusColor 1 .75 0 1

        onOpen {
            // Both createserver and joinserver are fullScreen, and Q3's menu
            // system paints every visible menu rather than just the top one -
            // so one left open behind another shows through it, headers and
            // all. Closing them here means returning to main always clears
            // whatever was underneath.
            close io_createserver ;
            close io_joinserver ;
            // OPTIONS and DEMOS hide this group on the way out. Nothing used to
            // bring it back, so returning to main left the background painted
            // with no buttons on it.
            show mainnav ;
            setitemcolor fadebox backcolor 0 0 0 1 ;
            fadeout fadebox ;
            uiScript stopRefresh ;
            uiScript loadGameInfo
        }

        onESC {
            open quit_popmenu
        }

        // RENDER
        itemDef {
            name renderbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 400 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name renderbtn
            group mainnav
            text "RENDER"
            type 1
            textstyle 6
            rect 0 400 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { open io_renderoptions }
            mouseEnter { setitemcolor renderbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor renderbar backcolor 0.5 0.1 0 .25 }
        }

        // JOIN SERVER
        itemDef {
            name joinbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 200 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name joinserverbtn
            group mainnav
            text "JOIN SERVER"
            type 1
            textstyle 6
            rect 0 200 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { close io_createserver ; close main ; open io_joinserver }
            mouseEnter { setitemcolor joinbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor joinbar backcolor 0.5 0.1 0 .25 }
        }

        // NEW GAME
        itemDef {
            name browserbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 240 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name browser
            group mainnav
            text "NEW GAME"
            type 1
            textstyle 6
            rect 0 240 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { close io_joinserver ; close main ; open io_createserver }
            mouseEnter { setitemcolor browserbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor browserbar backcolor 0.5 0.1 0 .25 }
        }

        // DEMOS
        itemDef {
            name demobar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 280 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name demos
            group mainnav
            text "DEMOS"
            type 1
            textstyle 6
            rect 0 280 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { hide mainnav ; open demo }
            mouseEnter { setitemcolor demobar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor demobar backcolor 0.5 0.1 0 .25 }
        }

        // OPTIONS
        itemDef {
            name optionsbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 320 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name options
            group mainnav
            text "OPTIONS"
            type 1
            textstyle 6
            rect 0 320 320 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { hide mainnav ; open main_options ; open ingame_controls }
            mouseEnter { setitemcolor optionsbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor optionsbar backcolor 0.5 0.1 0 .25 }
        }

        // PLAYER
        itemDef {
            name playerbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect -155 360 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name playerbtn
            group mainnav
            text "PLAYER"
            type 1
            textstyle 6
            rect 0 360 310 30
            textalignx 10
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { open io_playersetup }
            mouseEnter { setitemcolor playerbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor playerbar backcolor 0.5 0.1 0 .25 }
        }

        // QUIT
        itemDef {
            name quitbar
            group mainnav
            style WINDOW_STYLE_GRADIENT
            rect 485 400 310 30
            backcolor 0.5 0.1 0 .25
            border 4
            bordercolor 0.5 0.5 0.5 1
            bordersize 1
            visible 1
            decoration
        }
        itemDef {
            name quit
            group mainnav
            text "QUIT"
            type 1
            textstyle 6
            rect 485 400 320 30
            textalignx 95
            textaligny 24
            textscale .416
            textalign ITEM_ALIGN_LEFT
            forecolor 1 1 1 1
            visible 1
            action { open quit_popmenu }
            mouseEnter { setitemcolor quitbar backcolor .75 0 0 .25 }
            mouseExit { setitemcolor quitbar backcolor 0.5 0.1 0 .25 }
        }

        // CREDITS
        itemDef {
            name copyright
            text "Quake Live (tm) Copyright 2015 Id Software LLC, a ZeniMax Media company. All Rights Reserved."
            textscale .25
            rect 0 440 640 40
            textalign ITEM_ALIGN_CENTER
            textaligny 32
            textalignx 320
            forecolor .75 0 0 .75
            visible 1
            decoration
        }

        itemDef {
            name fadebox
            style WINDOW_STYLE_FILLED
            background "ui/assets/fadebox.tga"
            forecolor 0 0 0 1
            backcolor 0 0 0 1
            rect 0 0 640 480
            visible 1
            decoration
        }
    }

    // =============================================
    // CREATE SERVER
    // =============================================
    menuDef {
        name "io_createserver"
        fullScreen MENU_TRUE
        rect 0 0 640 480
        visible MENU_FALSE
        focusColor 1 .75 0 1
        style WINDOW_STYLE_FILLED
        backcolor 0.05 0.05 0.08 1

        onOpen { uiScript loadArenas }
        onESC { close io_joinserver ; close io_createserver ; open main }

        // ---- TITLE BAR ----
        itemDef {
            style WINDOW_STYLE_FILLED
            rect 0 0 640 22
            backcolor 0.5 0.1 0 0.6
            visible 1
            decoration
        }
        itemDef {
            text "CREATE SERVER"
            textstyle 6
            textscale .28
            rect 10 2 200 20
            textaligny 16
            forecolor 1 1 1 1
            visible 1
            decoration
        }

        // ---- TAB BUTTONS ----
        itemDef {
            name tab_map
            text "Map"
            type 1
            textscale .22
            rect 10 26 75 18
            textalign ITEM_ALIGN_CENTER
            textalignx 37
            textaligny 14
            forecolor 1 1 1 1
            visible 1
            action {
                hide grpRules ;
                hide grpPhysics ;
                hide grpWeapons ;
                show grpMapSelect
            }
        }
        itemDef {
            name tab_rules
            text "Rules"
            type 1
            textscale .22
            rect 90 26 75 18
            textalign ITEM_ALIGN_CENTER
            textalignx 37
            textaligny 14
            forecolor 1 1 1 1
            visible 1
            action {
                hide grpMapSelect ;
                hide grpPhysics ;
                hide grpWeapons ;
                show grpRules
            }
        }
        itemDef {
            name tab_physics
            text "Physics"
            type 1
            textscale .22
            rect 170 26 75 18
            textalign ITEM_ALIGN_CENTER
            textalignx 37
            textaligny 14
            forecolor 1 1 1 1
            visible 1
            action {
                hide grpMapSelect ;
                hide grpRules ;
                hide grpWeapons ;
                show grpPhysics
            }
        }
        itemDef {
            name tab_weapons
            text "Weapons"
            type 1
            textscale .22
            rect 250 26 80 18
            textalign ITEM_ALIGN_CENTER
            textalignx 40
            textaligny 14
            forecolor 1 1 1 1
            visible 1
            action {
                hide grpMapSelect ;
                hide grpRules ;
                hide grpPhysics ;
                show grpWeapons
            }
        }

        // Separator line
        itemDef {
            style WINDOW_STYLE_FILLED
            rect 10 44 620 1
            backcolor 0.5 0.5 0.5 0.5
            visible 1
            decoration
        }

        // ---- Bottom buttons (always visible) ----
        itemDef {
            name startbtn
            text "START"
            type 1
            textscale .28
            textstyle 6
            rect 500 452 120 24
            textalign ITEM_ALIGN_CENTER
            textalignx 60
            textaligny 19
            forecolor 1 1 1 1
            visible 1
            action { uiScript StartServer }
            mouseEnter { setitemcolor startbtn forecolor 1 .75 0 1 }
            mouseExit { setitemcolor startbtn forecolor 1 1 1 1 }
        }
        itemDef {
            name backbtn
            text "BACK"
            type 1
            textscale .28
            textstyle 6
            rect 390 452 100 24
            textalign ITEM_ALIGN_CENTER
            textalignx 50
            textaligny 19
            forecolor 1 1 1 1
            visible 1
            action { close io_createserver ; open main }
            mouseEnter { setitemcolor backbtn forecolor 1 .75 0 1 }
            mouseExit { setitemcolor backbtn forecolor 1 1 1 1 }
        }

        // ======================================================
        // TAB: MAP SELECT
        // ======================================================

        // Gametype label
        itemDef {
            group grpMapSelect
            text "Game Type:"
            textscale .2
            rect 10 50 80 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        // Gametype selector
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_MULTI
            text ""
            cvar "ui_netGameType"
            cvarFloatList { "Free For All" 0 "Duel" 1 "Race" 2 "Team DM" 3 "Clan Arena" 4 "CTF" 5 "1-Flag CTF" 6 "Overload" 7 "Harvester" 8 "Freeze Tag" 9 "Domination" 10 "Attack/Defend" 11 "Red Rover" 12 }
            rect 90 50 150 15
            textaligny 12
            textalignx 2
            textscale .2
            forecolor 1 1 1 1
            visible 1
            action { uiScript loadArenas }
        }

        // Map list
        itemDef {
            name maplist
            group grpMapSelect
            rect 10 70 220 370
            type ITEM_TYPE_LISTBOX
            elementwidth 200
            elementheight 16
            font FONT_SANS
            textscale .18
            elementtype LISTBOX_TEXT
            feeder FEEDER_ALLMAPS
            border 1
            bordercolor 0.4 0.4 0.4 0.5
            forecolor 1 1 1 1
            backcolor 0 0 0 0.3
            outlinecolor 0.5 0.5 0.5 0.5
            visible 1
            columns 1 2 24 210
        }

        // Map preview background
        itemDef {
            group grpMapSelect
            style WINDOW_STYLE_FILLED
            rect 244 70 240 240
            backcolor 0 0 0 0.5
            visible 1
            decoration
        }
        // Map preview image (square)
        itemDef {
            group grpMapSelect
            rect 249 75 230 230
            visible 1
            decoration
            ownerdraw UI_MAPPREVIEW
        }

        // Server settings below the preview
        itemDef {
            group grpMapSelect
            text "Max Players:"
            textscale .2
            rect 250 320 80 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_MULTI
            text ""
            cvar "sv_maxClients"
            cvarFloatList { "2" 2 "4" 4 "6" 6 "8" 8 "10" 10 "12" 12 "16" 16 }
            rect 340 320 60 15
            textaligny 12
            textalignx 2
            textscale .2
            forecolor 1 1 1 1
            visible 1
        }

        itemDef {
            group grpMapSelect
            text "Dedicated:"
            textscale .2
            rect 410 320 60 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_YESNO
            text ""
            cvar "ui_dedicated"
            rect 475 320 50 15
            textaligny 12
            textalignx 2
            textscale .2
            forecolor 1 1 1 1
            visible 1
        }

        itemDef {
            group grpMapSelect
            text "Hostname:"
            textscale .2
            rect 250 340 80 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_EDITFIELD
            text ""
            cvar "sv_hostname"
            rect 335 340 190 15
            textaligny 12
            textalignx 2
            textscale .2
            forecolor 1 1 1 1
            border 1
            bordercolor 0.4 0.4 0.4 0.5
            maxchars 32
            visible 1
        }

        // Right-side quick settings
        itemDef {
            group grpMapSelect
            text "Bot Skill:"
            textscale .2
            rect 500 70 60 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_MULTI
            text ""
            cvar "g_spSkill"
            cvarFloatList { "Easy" 1 "Medium" 2 "Normal" 3 "Hard" 4 "Nightmare" 5 }
            rect 565 70 65 15
            textaligny 12
            textalignx 2
            textscale .18
            forecolor 1 1 1 1
            visible 1
        }

        itemDef {
            group grpMapSelect
            text "Time Limit:"
            textscale .2
            rect 500 90 60 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_MULTI
            text ""
            cvar "timelimit"
            cvarFloatList { "None" 0 "5" 5 "10" 10 "15" 15 "20" 20 "30" 30 }
            rect 565 90 65 15
            textaligny 12
            textalignx 2
            textscale .18
            forecolor 1 1 1 1
            visible 1
        }

        itemDef {
            group grpMapSelect
            text "Frag Limit:"
            textscale .2
            rect 500 110 60 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_MULTI
            text ""
            cvar "fraglimit"
            cvarFloatList { "None" 0 "10" 10 "25" 25 "50" 50 "100" 100 "200" 200 }
            rect 565 110 65 15
            textaligny 12
            textalignx 2
            textscale .18
            forecolor 1 1 1 1
            visible 1
        }

        itemDef {
            group grpMapSelect
            text "Cap Limit:"
            textscale .2
            rect 500 130 60 15
            textaligny 12
            forecolor 0.8 0.8 0.8 1
            visible 1
            decoration
        }
        itemDef {
            group grpMapSelect
            type ITEM_TYPE_MULTI
            text ""
            cvar "capturelimit"
            cvarFloatList { "None" 0 "3" 3 "5" 5 "8" 8 "10" 10 "15" 15 }
            rect 565 130 65 15
            textaligny 12
            textalignx 2
            textscale .18
            forecolor 1 1 1 1
            visible 1
        }

        // ======================================================
        // TAB: GAME RULES
        // ======================================================

        // -- Left column --
        itemDef {
            group grpRules
            text "Match Rules"
            textscale .22
            textstyle 6
            rect 10 50 200 16
            textaligny 13
            forecolor 1 0.75 0 1
            visible 0
            decoration
        }

        // Round Limit
        itemDef { group grpRules  text "Round Limit:"  textscale .2  rect 20 70 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "roundlimit"  cvarFloatList { "None" 0 "3" 3 "5" 5 "7" 7 "9" 9 "11" 11 "15" 15 }  rect 150 70 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Team Size
        itemDef { group grpRules  text "Team Size:"  textscale .2  rect 20 90 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_teamsize"  cvarFloatList { "No Limit" 0 "1v1" 1 "2v2" 2 "3v3" 3 "4v4" 4 "5v5" 5 "6v6" 6 "8v8" 8 }  rect 150 90 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Overtime
        itemDef { group grpRules  text "Overtime (sec):"  textscale .2  rect 20 110 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_overtime"  cvarFloatList { "None" 0 "30" 30 "60" 60 "120" 120 "180" 180 }  rect 150 110 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Loadout
        itemDef { group grpRules  text "Loadout:"  textscale .2  rect 20 130 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_YESNO  text ""  cvar "g_loadout"  rect 150 130 50 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Item Timers
        itemDef { group grpRules  text "Item Timers:"  textscale .2  rect 20 150 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_YESNO  text ""  cvar "g_itemTimers"  rect 150 150 50 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Item Height
        itemDef { group grpRules  text "Item Height:"  textscale .2  rect 20 170 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_itemHeight"  cvarFloatList { "Ground" 0 "Floating" 36 }  rect 150 170 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Weapon Respawn
        itemDef { group grpRules  text "Weapon Respawn:"  textscale .2  rect 20 190 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_weaponRespawn"  cvarFloatList { "5s" 5 "10s" 10 "15s" 15 "20s" 20 "30s" 30 }  rect 150 190 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Gravity
        itemDef { group grpRules  text "Gravity:"  textscale .2  rect 20 210 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_gravity"  cvarFloatList { "Moon (200)" 200 "Low (400)" 400 "Normal (800)" 800 "High (1200)" 1200 }  rect 150 210 100 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Quad Factor
        itemDef { group grpRules  text "Quad Factor:"  textscale .2  rect 20 230 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_quadDamageFactor"  cvarFloatList { "2x" 2 "3x" 3 "4x" 4 }  rect 150 230 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // -- Right column: Spawn --
        itemDef {
            group grpRules
            text "Spawn Settings"
            textscale .22
            textstyle 6
            rect 300 50 200 16
            textaligny 13
            forecolor 1 0.75 0 1
            visible 0
            decoration
        }

        // Starting Health
        itemDef { group grpRules  text "Starting Health:"  textscale .2  rect 310 70 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_startingHealth"  cvarFloatList { "50" 50 "100" 100 "125" 125 "150" 150 "200" 200 }  rect 440 70 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Health Bonus
        itemDef { group grpRules  text "Health Bonus:"  textscale .2  rect 310 90 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_startingHealthBonus"  cvarFloatList { "0" 0 "25" 25 "50" 50 "100" 100 }  rect 440 90 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // Starting Armor
        itemDef { group grpRules  text "Starting Armor:"  textscale .2  rect 310 110 120 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpRules  type ITEM_TYPE_MULTI  text ""  cvar "g_startingArmor"  cvarFloatList { "0" 0 "25" 25 "50" 50 "100" 100 "150" 150 "200" 200 }  rect 440 110 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        // ======================================================
        // TAB: PHYSICS
        // ======================================================

        // -- Left column --
        itemDef {
            group grpPhysics
            text "Movement"
            textscale .22
            textstyle 6
            rect 10 50 200 16
            textaligny 13
            forecolor 1 0.75 0 1
            visible 0
            decoration
        }

        itemDef { group grpPhysics  text "Air Control (CPM):"  textscale .2  rect 20 70 140 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpPhysics  type ITEM_TYPE_YESNO  text ""  cvar "pmove_AirControl"  rect 170 70 50 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpPhysics  text "Double Jump:"  textscale .2  rect 20 90 140 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpPhysics  type ITEM_TYPE_YESNO  text ""  cvar "pmove_DoubleJump"  rect 170 90 50 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpPhysics  text "Crouch Slide:"  textscale .2  rect 20 110 140 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpPhysics  type ITEM_TYPE_YESNO  text ""  cvar "pmove_CrouchSlide"  rect 170 110 50 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpPhysics  text "Bunny Hop:"  textscale .2  rect 20 130 140 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpPhysics  type ITEM_TYPE_YESNO  text ""  cvar "pmove_BunnyHop"  rect 170 130 50 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpPhysics  text "Auto Hop:"  textscale .2  rect 20 150 140 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
