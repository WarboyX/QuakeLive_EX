            group grpWeapons
            text "More Ammo"
            textscale .22
            textstyle 6
            rect 300 50 200 16
            textaligny 13
            forecolor 1 0.75 0 1
            visible 0
            decoration
        }

        itemDef { group grpWeapons  text "BFG:"  textscale .2  rect 310 70 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_bfg"  cvarFloatList { "5" 5 "10" 10 "25" 25 "50" 50 "999" 999 }  rect 420 70 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpWeapons  text "Chaingun:"  textscale .2  rect 310 90 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
