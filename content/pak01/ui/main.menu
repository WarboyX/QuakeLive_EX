        itemDef { group grpWeapons  type ITEM_TYPE_MULTI  text ""  cvar "g_startingAmmo_hmg"  cvarFloatList { "25" 25 "50" 50 "100" 100 "150" 150 "999" 999 }  rect 420 110 80 15  textaligny 12  textalignx 2  textscale .2  forecolor 1 1 1 1  visible 0 }

        itemDef { group grpWeapons  text "Nailgun:"  textscale .2  rect 310 130 100 15  textaligny 12  forecolor 0.8 0.8 0.8 1  visible 0  decoration }
