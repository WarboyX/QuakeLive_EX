#include "ui/menudef.h"

// io_teamselect - the team buttons for the in-game menu.
//
// Why this file exists
// --------------------
// Quake Live's in-game menu draws RETURN to MATCH and SPECTATE but not the join
// buttons - they are in its own menu behind a visibility condition this build
// does not satisfy - which left players with no way to change team at all
// without knowing to type "cmd team r" into the console.
//
// The buttons are the whole of the gap. The server side has always worked:
// Cmd_Team_f accepts r/red, b/blue and s/spectator, and enforces its own rules
// (the five-second switch limit, team lock, the duel loss), so these are
// ordinary client commands and not a new code path. There is no auto-join
// button: the game already balances a player who joins without naming a side.
//
// It is a menu of ours rather than an edit to Quake Live's ui/ingame_join.menu
// because pak00 is not ours to ship or modify. Loaded by ui/io_ingame.txt, which
// UI_LoadExtraMenus reads after Quake Live's own ui/ingame.txt, and activated
// with the in-game menu in _UI_SetActiveMenu.
//
// The io_ prefix is the rule main.menu documents: Menus_FindByName returns the
// first match, so an unprefixed name could collide with one of Quake Live's and
// leave "open" and "close" acting on different menus.
//
// Layout
// ------
// Quake Live's own arrangement: the two join buttons share one row, half the
// column's width each, with SPECTATE full width beneath them - all continuing
// the column under RETURN to MATCH.
//
// The rects below are a fallback only. UI_PlaceTeamSelect (ui_main.c) measures
// Quake Live's SPECTATE button when the menu opens, hides it, and lays these
// three out in its place at the same x, width and row height.
//
// Hiding Quake Live's button is what makes the alignment tractable. Two controls
// doing the same job in one column, one positioned by us and one not, is what
// kept ending up overlapped; owning the whole stack means the spacing is ours to
// get right rather than something to dodge.
//
// It is measured rather than hardcoded because the numbers cannot be read from
// here - pak00 is not in this tree - so anything fixed is a measurement of one
// screenshot, which is how this landed wrong twice. Note they are not pixels
// either way: menu rects are a virtual 640x480 space that Item_SetScreenCoords
// scales to the real display, so they do not move with resolution.

{
    menuDef {
        name "io_teamselect"
        rect 425 198 156 45
        visible MENU_TRUE
        focusColor 1 .75 0 1

        // No fullScreen and no background: this is a panel that paints on top of
        // the in-game menu, not a page that replaces it. Q3 paints every visible
        // menu rather than only the topmost, which is the property being used
        // here rather than worked around.

        itemDef {
            name teamselect_redbar
            style WINDOW_STYLE_FILLED
            rect 0 0 76 21
            backcolor 0.55 0.11 0.11 0.90
            visible 1
            decoration
        }
        itemDef {
            name teamselect_red
            text "JOIN RED"
            type 1
            textstyle 6
            rect 0 0 76 21
            textalign ITEM_ALIGN_CENTER
            textalignx 38
            textaligny 15
            textscale .25
            forecolor 1 1 1 1
            visible 1
            // "cmd" forwards to the server, which is where the team rules live.
            // closeingame is Quake Live's own script: it drops KEYCATCH_UI,
            // clears key states and unpauses, so the menu does not stay up over
            // a player who has just spawned.
            action { exec "cmd team r" ; uiScript closeingame }
            mouseEnter { setitemcolor teamselect_redbar backcolor .85 .18 .18 1.0 }
            mouseExit  { setitemcolor teamselect_redbar backcolor 0.55 0.11 0.11 0.90 }
        }

        itemDef {
            name teamselect_bluebar
            style WINDOW_STYLE_FILLED
            rect 80 0 76 21
            backcolor 0.13 0.18 0.60 0.90
            visible 1
            decoration
        }
        itemDef {
            name teamselect_blue
            text "JOIN BLUE"
            type 1
            textstyle 6
            rect 80 0 76 21
            textalign ITEM_ALIGN_CENTER
            textalignx 38
            textaligny 15
            textscale .25
            forecolor 1 1 1 1
            visible 1
            action { exec "cmd team b" ; uiScript closeingame }
            mouseEnter { setitemcolor teamselect_bluebar backcolor .22 .30 .90 1.0 }
            mouseExit  { setitemcolor teamselect_bluebar backcolor 0.13 0.18 0.60 0.90 }
        }

        // Replaces Quake Live's own SPECTATE, which UI_PlaceTeamSelect hides.
        itemDef {
            name teamselect_specbar
            style WINDOW_STYLE_FILLED
            rect 0 24 156 21
            backcolor 0.20 0.20 0.20 0.85
            visible 1
            decoration
        }
        itemDef {
            name teamselect_spec
            text "SPECTATE"
            type 1
            textstyle 6
            rect 0 24 156 21
            textalign ITEM_ALIGN_CENTER
            textalignx 78
            textaligny 15
            textscale .3
            forecolor 1 1 1 1
            visible 1
            action { exec "cmd team s" ; uiScript closeingame }
            mouseEnter { setitemcolor teamselect_specbar backcolor .4 .4 .4 .9 }
            mouseExit  { setitemcolor teamselect_specbar backcolor 0.20 0.20 0.20 0.85 }
        }
    }
}
