#version 450

/*
[QL] Screen-space reflections, on the map's water planes.

Water in these maps is a scrolling texture. This gives it back what it reflects.

Why a plane and not a surface flag: the map has a handful of distinct water
heights, collected once at load by vk_find_water_planes. Testing a reconstructed
world position against a few planes costs a compare; marking water per surface
at draw time costs new pipeline state or a stencil bit and makes every water
surface special for the rest of the frame.

Why screen space and not the acceleration structure: rtVertex_t is three floats.
The structure knows where geometry is and nothing about what it looks like, so a
ray hit cannot be shaded without UVs, a material index and texture indexing added
to it. Marching the depth buffer needs none of that. The cost is the standard
one - what is not on screen cannot be reflected - and the fade at the end is
where that gets hidden rather than pretended away.

Two variants, for the same reason rtao.tmpl has two: with r_ext_multisample on
there is no single-sample depth image to read.
*/

#ifdef USE_MSAA
layout(set = 0, binding = 0) uniform sampler2DMS depthMap;
#else
layout(set = 0, binding = 0) uniform sampler2D depthMap;
#endif
layout(set = 0, binding = 1) uniform sampler2D sceneMap;

#define SSR_MAX_PLANES 32

layout(set = 0, binding = 2) uniform SSR {
	mat4 viewProj;      // world -> clip
	mat4 invViewProj;   // clip -> world
	vec4 eye;           // xyz = view origin
	/*
	  x  strength: how much of the reflection survives, r_ssrStrength
	  y  how far a ray travels in world units before giving up
	  z  how many steps it takes getting there
	  w  thickness: how far behind a depth sample still counts as hitting it,
	     in world units. Too small and rays tunnel through thin geometry; too
	     large and a ray "hits" the empty space in front of a distant wall.
	*/
	vec4 params;
	/*
	  x  the value the depth buffer is cleared to
	  y  where the weapon's squashed depth range begins
	  z  +1 when near is 1.0 and far is 0.0 (USE_REVERSED_DEPTH), -1 otherwise
	  w  r_ssrDebug: 0 normal, 1 the water mask, 2 the raw reflection,
	     3 what the depth buffer was taken to mean
	*/
	vec4 depthInfo;
	vec4 planes[SSR_MAX_PLANES];      // xyz = normal, w = dist
	vec4 boundsMin[SSR_MAX_PLANES];   // xyz = world minimum of the water on it
	vec4 boundsMax[SSR_MAX_PLANES];   // xyz = world maximum
	vec4 planeCount;                  // x = how many are filled
	/*
	  x  slope: how far the surface normal is allowed to tilt, r_waterWaveSteepness
	  y  world units per wavelength of the largest wave, r_waterWaveScale
	  z  speed, r_waterWaveSpeed
	  w  seconds, for the animation. x at 0 means flat water.
	*/
	vec4 wave;
	/*
	  x  crest-to-trough height in world units, r_waterWaveHeight
	  y..w  spare - the obvious next occupant is a short list of disturbance
	        sources for splashes, which want exactly this height field with a
	        decaying radial term added to it
	*/
	vec4 wave2;
};

layout(location = 0) in vec2 frag_tex_coord;
layout(location = 0) out vec4 out_color;

ivec2 depthSize() {
#ifdef USE_MSAA
	return textureSize(depthMap);
#else
	return textureSize(depthMap, 0);
#endif
}

float fetchDepth(ivec2 p) {
	return texelFetch(depthMap, p, 0).r;
}

vec3 worldAt(ivec2 p, vec2 invSize) {
	float d = fetchDepth(p);
	vec2 uv = (vec2(p) + 0.5) * invSize;
	vec4 clip = vec4(uv * 2.0 - 1.0, d, 1.0);
	vec4 w = invViewProj * clip;
	return w.xyz / w.w;
}

/*
[QL] The direction the eye is looking through this pixel, from the pixel alone.

Deliberately not normalize(worldAt(p) - eye). That answer is the same only when
the depth buffer is trustworthy, and the whole difficulty here has been pixels
where it is not: the view weapon is stored in a squashed depth range, so
unprojecting it with the ordinary matrix gives a position that is not where the
weapon is, and a pixel whose depth lands on the near plane unprojects to the eye
itself, where normalize() is a division by zero.

Unprojecting a fixed mid-frustum depth has neither problem. 0.5 is inside the
frustum under both depth conventions and nowhere near a degenerate w, and the
ray through a pixel does not depend on what was drawn there - so the plane test
below now asks a question about geometry only.
*/
vec3 rayAt(ivec2 p, vec2 invSize) {
	vec2 uv = (vec2(p) + 0.5) * invSize;
	vec4 w = invViewProj * vec4(uv * 2.0 - 1.0, 0.5, 1.0);
	return normalize(w.xyz / w.w - eye.xyz);
}

/*
[QL] Waves, without moving a single vertex.

R19 ruled out geometry waves and the reasoning still holds: deformVertexes moves
the vertices a surface already has, and Quake Live's water is subdivided at map
compile time from the shader's tessSize. A runtime override cannot retessellate
it, so coarse water would heave in flat slabs.

None of that matters here, because what sells a wave to the eye is not the
silhouette - at these angles you can barely see it - it is what the surface
*reflects*. The reflected direction is reflect(V, N). Tilt N and the reflection
slides; tilt it in a travelling pattern and the reflection ripples. The surface
stays geometrically flat and nobody can tell.

Three directional waves rather than one, at 1x, 1.7x and 3.1x the base
frequency. Non-integer ratios on purpose: with harmonics the pattern repeats
visibly, and the eye finds a repeat in water immediately. Amplitudes sum to 1 so
that r_waterWaveSteepness is the actual maximum slope and not an arbitrary
scale - a number a person can reason about rather than tune blind.

Computed in world XY with Z up, which is exact here rather than an
approximation: vk_find_water_planes keeps only up-facing surfaces, and in
practice a Quake water brush's top face is exactly (0,0,1). A tilted water plane
would want a tangent basis; there is no such thing in this game.

The perturbed normal is used for shading only - for the reflected direction and
for the Fresnel term. Where the surface *is* stays the flat plane, because
that is what the geometry and the depth buffer agree on, and moving it would put
the reflection somewhere the water is not.
*/
/* The three waves, evaluated once. sin for the height, cos for the slope -
   which is the actual derivative, so crests and flats stay in step however the
   two are scaled. */
const vec2 WAVE_D0 = vec2( 0.80,  0.60);
const vec2 WAVE_D1 = vec2(-0.55,  0.84);
const vec2 WAVE_D2 = vec2( 0.31, -0.95);

vec3 wavePhase(vec2 p) {
	float k0 = 6.2831853 / max(wave.y, 8.0);
	float t = wave.w * wave.z;
	return vec3(
		dot(WAVE_D0, p) * k0         + t * 1.00,
		dot(WAVE_D1, p) * k0 * 1.7   + t * 1.30,
		dot(WAVE_D2, p) * k0 * 3.1   + t * 1.70 );
}

/* Height above the flat plane, in world units. */
float waveHeight(vec2 p) {
	if (wave2.x <= 0.0) {
		return 0.0;
	}
	vec3 ph = wavePhase(p);
	return wave2.x * ( 0.55 * sin(ph.x) + 0.30 * sin(ph.y) + 0.15 * sin(ph.z) );
}

vec3 waveNormal(vec2 p) {
	if (wave.x <= 0.0) {
		return vec3(0.0, 0.0, 1.0);
	}
	vec3 ph = wavePhase(p);

	/* gradient of the same sum, which is the slope at this point */
	vec2 grad = WAVE_D0 * 0.55 * cos(ph.x)
	          + WAVE_D1 * 0.30 * cos(ph.y)
	          + WAVE_D2 * 0.15 * cos(ph.z);

	return normalize(vec3(-grad * wave.x, 1.0));
}

/* clip -> screen uv, and the depth that came with it */
vec3 project(vec3 world) {
	vec4 clip = viewProj * vec4(world, 1.0);
	if (clip.w <= 0.0) {
		return vec3(-1.0);          // behind the eye
	}
	vec3 ndc = clip.xyz / clip.w;
	return vec3(ndc.xy * 0.5 + 0.5, ndc.z);
}

void main() {
	ivec2 size = depthSize();
	ivec2 pix = clamp(ivec2(gl_FragCoord.xy), ivec2(0), size - ivec2(1));
	vec2 invSize = 1.0 / vec2(size);

	float depth = fetchDepth(pix);

	out_color = vec4(0.0);

	/*
	[QL] r_ssrDebug 4: the depth buffer itself, before anything is decided about
	it. Near is bright, far is dark, under either depth convention.

	This should have existed before any of the others. Every debug view above
	shows a *classification* - a threshold applied to this number - and a
	threshold applied to bad data does not look like bad data. It looks like a
	bad threshold, which is where four rounds of work went: at the water test,
	at the plane bounds, at the weapon band, at two image layouts. Each was
	answered with a picture that was itself downstream of the thing that was
	wrong.

	What this one shows cannot be argued with:

	  a smooth distance field, the gun clearly in front - depth is sound, and
	    whatever is wrong is in what this pass does with it
	  the room's textures, the HUD, glyphs - this is not the depth image at all
	  the previous frame, or several - the read is racing the next frame's
	    writes, which is the "out of bounds smear" this looks like

	Those three need completely different fixes and nothing above distinguishes
	them.

	The fourth root makes the reversed range visible: with near at 1.0 most of a
	room sits close to 0 and a linear grey would be almost entirely black.
	*/
	if (depthInfo.w == 4.0) {
		float d = clamp(depth, 0.0, 1.0);
		float near1 = (depthInfo.z > 0.0) ? d : 1.0 - d;
		out_color = vec4(vec3(pow(near1, 0.25)), 1.0);
		return;
	}

	// nothing drawn here - sky, or outside the world
	bool isSky = (depthInfo.z * (depth - depthInfo.x) <= 0.0);

	/*
	The view weapon lives in a squashed depth range and is not water.

	>= and not >, to agree with the occlusion pass exactly. A fragment sitting on
	the boundary of the weapon's range is the weapon, and the two passes
	disagreeing about one value is the kind of difference that is invisible until
	it is the thing you are chasing.
	*/
	bool isWeapon = !isSky && (depthInfo.z * (depth - depthInfo.y) >= 0.0);

	/*
	[QL] r_ssrDebug 3: what this pass thinks the depth buffer is telling it.

	  red    sky, or nothing drawn
	  blue   inside the weapon's squashed depth range
	  green  ordinary world geometry

	This exists because "the reflection is appearing on the gun" has two
	completely different causes and they need opposite fixes. If the gun comes
	out blue, this pass is rejecting it correctly and whatever is drawn over it
	arrived from somewhere else - the composite, or the blend. If the gun comes
	out green, the weapon band is not where this pass was told it is, and no
	amount of work on the water test will help.

	Reading it off the screen takes one screenshot. Reasoning about it from the
	source has so far taken several rounds and got the wrong answer each time.
	*/
	if (depthInfo.w == 3.0) {
		out_color = isSky    ? vec4(1.0, 0.0, 0.0, 1.0)
		          : isWeapon ? vec4(0.0, 0.0, 1.0, 1.0)
		                     : vec4(0.0, 1.0, 0.0, 1.0);
		return;
	}

	if (isSky || isWeapon) {
		return;
	}

	/*
	[QL] Where is the water in this pixel? Ask the plane, not the depth buffer.

	The first version reconstructed a world position from depth and tested it
	against the plane. That fails on both sides at once, and the debug view made
	both visible in one frame:

	  - Quake Live's water does not write depth. It is a translucent surface, so
	    the depth at a water pixel is the *pool floor*, metres below the surface.
	    The water was therefore never detected at all - no tolerance around the
	    plane could have helped, because the surface is simply not in the buffer.
	  - The plane is infinite. Every *other* surface in the map at the water's
	    height did match, which on this map is the wooden decking around the
	    pool, painted in speckles and bands along the height lines.

	Intersecting the view ray with the plane answers the question directly and
	needs neither fix: it finds the water surface whether or not anything wrote
	depth there, and it gives the true position rather than an approximation of
	one. Depth is still needed - to know whether something opaque is in front of
	the water - which is what the sceneDist test below is.
	*/
	vec3 sceneP = worldAt(pix, invSize);
	float sceneDist = length(sceneP - eye.xyz);
	vec3 dir = rayAt(pix, invSize);

	int count = int(planeCount.x);
	vec3 N = vec3(0.0);
	float bestT = 1.0e30;
	float bestW = 0.0;
	int bestIdx = -1;
	bool onWater = false;

	for (int i = 0; i < count; i++) {
		vec3 n = planes[i].xyz;
		float dn = dot(dir, n);

		/*
		Facing away. For an up-facing plane this is the ray travelling upward,
		which is either the underside of the surface or the camera being below
		it - and neither reflects the world above. Underwater is handled here
		rather than as a special case.
		*/
		if (dn >= -0.0001) {
			continue;
		}

		float t = (planes[i].w - dot(eye.xyz, n)) / dn;
		if (t <= 0.0) {
			continue;                 // behind the eye
		}
		/*
		There has to be a pool under it.

		This started as "is anything opaque in front of the water", allowing a
		few units of slack for the case where the water writes depth and t and
		sceneDist are the same number. Quake Live's water does not write depth -
		the debug view settled that - so the slack bought nothing and cost the
		test its discrimination.

		What it cost is specific: the decking around a pool tends to sit at the
		water's own height, which is why the very first version of this test
		painted the decking. For a decking pixel the distance to the plane and
		the distance to the decking are nearly equal, so any slack lets it
		through, and at a glancing angle that is most of the screen.

		Requiring the surface to be meaningfully nearer than the geometry behind
		it says "water has a pool under it" instead of "water is at this height",
		and a floor at the water's height has nothing under it at all. It also
		rejects everything in front of the water - the view weapon included -
		without needing to know what any of it is.

		The cost is a thin band where the surface meets the pool wall, which was
		going to fade out there anyway.
		*/
		if (t > sceneDist - 8.0) {
			continue;
		}

		/*
		And whatever is under it has to be under it.

		A straight ray that crosses a plane downward is below that plane for the
		rest of its length, so for consistent data this follows from the test
		above and rejects nothing. That is the point of it. It fires only when
		the position reconstructed from depth does not belong to this ray, which
		is a real failure mode rather than a hypothetical one: the view weapon is
		stored in a squashed depth range, a multisampled buffer hands back one
		sample that may belong to a different primitive than the pixel's
		coverage, and either produces a distance that passes the test above for
		no good reason.

		One dot product to make an inconsistency visible as rejection instead of
		as water in the wrong place.
		*/
		if (dot(sceneP, n) > planes[i].w + 1.0) {
			continue;
		}

		/*
		Inside the water surface - which is not the same as inside the pool, and
		must not be mistaken for it.

		A mapper builds the water brush larger than the hole it shows through
		and tucks the overhang under the decking, in X and Y but rarely in Z.
		There is nothing to gain from trimming it to the opening and something
		to lose: a seam if the two ever disagree. So these bounds legitimately
		run past the visible pool by however far that overhang goes, and no
		tightening of them can be right - the surface really is out there.

		What decides whether it can be *seen* out there is the test above: under
		the decking the decking is in front of it, so the geometry at that pixel
		is nearer than the plane crossing and the pixel is rejected. That is
		where the real edge of the pool comes from. This test only says which
		reflector, if any, the ray could have met.
		*/
		vec3 hit = eye.xyz + dir * t;
		if (any(lessThan(hit, boundsMin[i].xyz - 1.0)) ||
		    any(greaterThan(hit, boundsMax[i].xyz + 1.0))) {
			continue;
		}

		if (t < bestT) {
			bestT = t;
			bestW = planes[i].w;
			bestIdx = i;
			N = n;
			onWater = true;
		}
	}
	if (!onWater) {
		return;
	}

	/*
	[QL] Put the surface on the wave, rather than only tilting it.

	The tilt alone gives a rippling reflection on a surface that is still, in
	every other respect, a sheet of glass at a fixed height. Solving the
	intersection again against a plane displaced by the wave height gives real
	Z variance, and two things follow from it that the tilt cannot produce: the
	waterline against the pool wall rises and falls, and the reflection
	parallaxes - it stretches over a trough and compresses over a crest, which
	is most of what makes water read as a surface with a thickness rather than a
	picture.

	Two iterations. The height depends on where the ray lands and where the ray
	lands depends on the height, so this is a fixed point; for amplitudes small
	against the wavelength it is converged well inside a pixel after two.

	Three guards, and each one is a real case rather than defensive habit:

	  the grazing cutoff - as dot(dir, N) approaches zero the solve divides by
	    it, and a two-unit change in height moves the intersection an unbounded
	    distance along the ray. Physically that is true, a crest really does
	    occlude a long way at grazing incidence, but it is not something to
	    compute this way.
	  the occlusion and bounds re-test - the displaced point is somewhere the
	    flat point was not, and it has to earn its place by the same rules. A
	    crest can lift the surface in front of the pool lip.
	  falling back to the flat solve rather than discarding - the pixel is still
	    water. It just gets this frame's reflection from the undisplaced
	    surface, which is where it came from before any of this.
	*/
	if (wave2.x > 0.0 && bestIdx >= 0) {
		float dn = dot(dir, N);
		if (dn < -0.02) {
			float t2 = bestT;
			float eyeN = dot(eye.xyz, N);

			t2 = (bestW + waveHeight((eye.xyz + dir * t2).xy) - eyeN) / dn;
			t2 = (bestW + waveHeight((eye.xyz + dir * t2).xy) - eyeN) / dn;

			if (t2 > 0.0 && t2 < sceneDist - 8.0) {
				vec3 hp = eye.xyz + dir * t2;
				if (!any(lessThan(hp, boundsMin[bestIdx].xyz - 1.0)) &&
				    !any(greaterThan(hp, boundsMax[bestIdx].xyz + 1.0))) {
					bestT = t2;
				}
			}
		}
	}

	vec3 P = eye.xyz + dir * bestT;

	/*
	[QL] r_ssrDebug 1: where the water test passed, and nothing else.

	This separates the three ways the feature can produce no visible change, and
	they need completely different fixes:

	  a black screen  - the pass is not running at all
	  no green        - the plane test never matches, so the depth buffer does
	                    not contain the water surface. That happens when the
	                    water shader does not write depth, in which case the
	                    depth there is the pool floor and no tolerance around
	                    the plane will ever help
	  green, no image - water is found and the march finds nothing, which is
	                    distance, steps or thickness

	Worth the eight lines. Guessing between those three from "the water looks
	the same" is exactly the loop that has cost the most time on this project.
	*/
	if (depthInfo.w == 1.0) {
		out_color = vec4(0.0, 1.0, 0.0, 1.0);
		return;
	}

	/* The ray that found the plane is the view vector. Looking at the surface
	   from beneath was already rejected by the facing test above. */
	vec3 V = dir;

	/*
	Shading normal from here on: the waves live in this and nowhere else. P is
	still on the flat plane, which is what the depth buffer and the geometry
	agree about.

	Kept facing the viewer. At a glancing angle - which is most of how water is
	ever seen - a steep enough wave can tilt the normal past the view direction,
	and reflect() about a normal facing away sends the ray into the surface
	instead of off it. That is a black pixel in the middle of the water, and it
	flickers, because the wave that caused it is moving.
	*/
	N = waveNormal(P.xy);
	if (dot(N, -V) <= 0.02) {
		N = normalize(N - V * (dot(N, V) + 0.02));
	}

	vec3 R = reflect(V, N);

	float maxDist = params.y;
	int steps = int(params.z);
	float thickness = params.w;

	/*
	March in world space and project each step, rather than interpolating a
	screen-space line.

	A screen-space march is cheaper per step and wrong at glancing angles: even
	spacing on screen is wildly uneven in the world, so the first step off a
	near-horizontal water surface can jump past a whole wall. Water is only ever
	seen at glancing angles, so the cheap version fails exactly where this is
	used.
	*/
	vec3 hitColor = vec3(0.0);
	float hit = 0.0;
	float stepLen = maxDist / float(steps);

	/* Start a step out. At t=0 the ray is on the surface it came from and the
	   first sample would find that surface, which is the classic self-hit. */
	for (int i = 1; i <= steps; i++) {
		float t = stepLen * float(i);
		vec3 Q = P + R * t;
		vec3 s = project(Q);

		if (s.x < 0.0 || s.x > 1.0 || s.y < 0.0 || s.y > 1.0) {
			break;              // left the screen - nothing on screen to reflect
		}

		ivec2 sp = clamp(ivec2(s.xy * vec2(size)), ivec2(0), size - ivec2(1));
		float sceneDepth = fetchDepth(sp);

		if (depthInfo.z * (sceneDepth - depthInfo.x) <= 0.0) {
			continue;           // sky at that pixel, keep going
		}

		vec3 sceneP = worldAt(sp, invSize);

		/*
		Behind the recorded surface means the ray has gone past something.
		Compared along the view direction rather than in depth-buffer units,
		because the buffer is not linear and a fixed epsilon in it means a
		different distance at every range.
		*/
		float rayDist = length(Q - eye.xyz);
		float sceneDist = length(sceneP - eye.xyz);
		float behind = rayDist - sceneDist;

		if (behind > 0.0 && behind < thickness + stepLen) {
			hitColor = texture(sceneMap, s.xy).rgb;
			hit = 1.0;

			/*
			Fade out where the result stops being trustworthy, rather than
			letting it end abruptly:

			  - near the screen edge, because what is off-screen was never
			    traced and the boundary would otherwise be a hard line
			  - with distance, because a longer march found its hit with fewer
			    effective samples
			  - at steep viewing angles, where a real water surface reflects
			    least and the march is most accurate - the Fresnel-ish term
			    that makes it look like water rather than a mirror
			*/
			vec2 edge = min(s.xy, 1.0 - s.xy) / 0.12;
			float edgeFade = clamp(min(edge.x, edge.y), 0.0, 1.0);
			float distFade = 1.0 - clamp(t / maxDist, 0.0, 1.0);
			float fresnel = pow(1.0 - clamp(dot(-V, N), 0.0, 1.0), 3.0);

			hit = edgeFade * distFade * mix(0.15, 1.0, fresnel);
			break;
		}
	}

	/* r_ssrDebug 2: the reflection itself, unfaded, and red where the march
	   found nothing - which tells distance/steps/thickness apart from a bad
	   reflection. */
	if (depthInfo.w == 2.0) {
		out_color = (hit > 0.0) ? vec4(hitColor, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
		return;
	}

	if (hit <= 0.0) {
		return;
	}

	out_color = vec4(hitColor, clamp(hit * params.x, 0.0, 1.0));
}
