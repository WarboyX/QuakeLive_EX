#version 460
#extension GL_EXT_ray_query : require

/*
[QL] R13 step 3: ray-traced ambient occlusion.

A fullscreen pass over the depth buffer. For each pixel it reconstructs the
world position and a normal, fires a handful of short rays into the hemisphere,
and returns the fraction that hit nothing.

It writes that to a single-channel offscreen target rather than into the scene,
because four rays per pixel is far too noisy to look at directly. rtao_blur.tmpl
denoises it and does the multiply against the lit image on its second pass. The
values here are therefore raw per-pixel estimates, and are meant to be.

The lighting stays baked. This does not compute light - it computes how much of
the sky-and-bounce ambient a corner is shut off from, which is the part
lightmaps at Quake 3's resolution get worst. That is the whole hybrid from R10:
ray trace the term the bake cannot express, keep everything else.

Two things about this shader are chosen and not accidents:

  No G-buffer. This is a forward renderer with no normal buffer, and adding one
  would mean a second attachment on the main pass and a matching change to every
  geometry pipeline in the renderer. The normal is reconstructed from depth
  instead - not with dFdx/dFdy, which is exact on a flat surface and wrong on
  every silhouette, but from the better of two neighbours on each axis. See the
  block where it is built.

  Cosine-weighted directions, not uniform. Ambient occlusion is a cosine-
  weighted integral over the hemisphere; sampling uniformly and multiplying by
  cos(theta) spends most of the rays near the horizon where the weight is
  smallest. Cosine sampling puts them where the answer is.

USE_MSAA builds the variant that reads a multisampled depth attachment. With
r_ext_multisample on, vk.depth_image has samples > 1 and an ordinary sampler2D
cannot read it at all - so this is two shaders rather than one, chosen by the
sample count at pipeline creation.

Sample 0 rather than an average of all of them. AO is a low-frequency term that
gets denoised afterwards, the sample positions within a pixel differ by less
than the trace radius by orders of magnitude, and resolving N depths per pixel
to feed a 4-ray occlusion estimate is precision nobody can see paid for N times.

The target is single-sample even when the scene is multisampled. AO is computed
once per pixel and applied to every sample of it at composite time, which is
what anti-aliasing an already-smooth term is worth.
*/

#ifdef USE_MSAA
layout(set = 0, binding = 0) uniform sampler2DMS depthMap;
#else
layout(set = 0, binding = 0) uniform sampler2D depthMap;
#endif
layout(set = 0, binding = 1) uniform accelerationStructureEXT topLevel;

layout(location = 0) in vec2 frag_tex_coord;
layout(location = 0) out vec4 out_color;

layout(push_constant) uniform Push {
	mat4 invViewProj;   // clip -> world
	vec4 eye;           // xyz = view origin
	vec4 params;        // x = radius, y = intensity, z = frame index, w = bias
	/*
	Which depth values mean "not a surface to shade", supplied rather than
	assumed because both depend on engine build options this shader cannot see.

	  x  the value the depth buffer is cleared to - nothing was drawn there
	  y  where the weapon's compressed depth range begins
	  z  +1 when near is 1.0 and far is 0.0 (USE_REVERSED_DEPTH), -1 otherwise

	Getting x backwards is not a subtle error: it traces the sky, from a
	position reconstructed at the far plane, and skips the near plane instead.
	*/
	vec4 depthInfo;
} pc;

layout(constant_id = 0) const int sampleCount = 4;

/*
Hash-based per-pixel rotation. A fixed sample set produces banding you can read
the pattern of; rotating it per pixel turns that into noise, which the spatial
denoise then removes. Including the frame index means successive frames use
different sets, so anything accumulating over time converges instead of
repeating.
*/
float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

/*
[QL] World position for an arbitrary pixel, from its depth.

Needed because the normal below is built from neighbouring pixels rather than
from the hardware derivative of this one, so it has to reconstruct positions
the derivative would have given it for free.
*/
/*
textureSize takes a mip level for sampler2D and none at all for sampler2DMS -
a multisampled image has no mip chain to index - so the two spellings differ
even though the answer does not.
*/
ivec2 depthSize() {
#ifdef USE_MSAA
	return textureSize(depthMap);
#else
	return textureSize(depthMap, 0);
#endif
}

/*
One body for both variants: texelFetch's third argument is a sample index for
sampler2DMS and a mip level for sampler2D, and 0 is what this wants either way.
*/
vec3 worldAt(ivec2 p, vec2 invSize) {
	float d = texelFetch(depthMap, p, 0).r;
	vec2 uv = (vec2(p) + 0.5) * invSize;
	vec4 clip = vec4(uv * 2.0 - 1.0, d, 1.0);
	vec4 w = pc.invViewProj * clip;
	return w.xyz / w.w;
}

void main() {
#ifdef USE_MSAA
	/* texelFetch, not texture: a multisampled sampler has no filtering and no
	   normalised coordinates. The AO pass is fullscreen at the same resolution
	   as the depth attachment, so gl_FragCoord maps one-to-one onto its texels
	   and there is nothing to scale. */
	float depth = texelFetch(depthMap, ivec2(gl_FragCoord.xy), 0).r;
#else
	float depth = texture(depthMap, frag_tex_coord).r;
#endif

	/*
	Nothing was drawn here - sky, or outside the world. Returning unoccluded is
	not only the cheap answer but the correct one: a ray fired from the far
	plane starts outside the world and hits the first thing behind the camera.

	Written against pc.depthInfo rather than a literal because this renderer
	uses reversed depth, where the cleared value is 0.0 and the near plane is
	1.0 - the opposite of the obvious test.
	*/
	if (pc.depthInfo.z * (depth - pc.depthInfo.x) <= 0.0) {
		out_color = vec4(1.0);
		return;
	}

	/*
	The view weapon. It is drawn with a squashed viewport depth range so it
	cannot poke through walls, which means its depth values do not describe
	where it actually is - reconstructing a world position from them puts it
	somewhere near the eye and the rays go off into geometry from inside it.
	The result is a patch of noise over the gun, in the corner of the screen,
	that looks like memory corruption and is not.

	Nothing else reaches this band: it is the front 40% of the depth range,
	which on a perspective projection is a few units from the eye.
	*/
	if (pc.depthInfo.z * (depth - pc.depthInfo.y) >= 0.0) {
		out_color = vec4(1.0);
		return;
	}

	// clip -> world
	vec4 clip = vec4(frag_tex_coord * 2.0 - 1.0, depth, 1.0);
	vec4 world = pc.invViewProj * clip;
	world /= world.w;
	vec3 P = world.xyz;

	/*
	[QL] The normal, from the best pair of neighbours rather than from dFdx/dFdy.

	The derivative version is exact on a flat surface and wrong on every
	silhouette, because a 2x2 quad that straddles a depth discontinuity spans
	two surfaces and the cross product of that is a normal belonging to neither.
	On a Quake map the silhouettes are exactly the edges AO is supposed to
	darken, so the error lands where the term is most visible: rays fired into
	the geometry they were meant to graze, and a dark fringe tracing every
	object against what is behind it.

	So this takes four taps - left, right, up, down - and for each axis keeps
	the side whose depth agrees better with the centre. Along an edge that is
	the side still on this surface; in the interior both agree and the result is
	the same as the derivative. Four extra depth fetches, no attachment, no
	change to any other pipeline.

	The remaining case is a one-pixel sliver with a discontinuity on both sides,
	where there is no good neighbour to be had. That reads as a wrong normal on
	a single pixel, which the denoise then averages away - the failure the
	derivative version had was a wrong normal along every edge in the frame,
	which it could not.
	*/
	ivec2 pix = ivec2(gl_FragCoord.xy);
	ivec2 size = depthSize();
	vec2 invSize = 1.0 / vec2(size);
	ivec2 lo = ivec2(0);
	ivec2 hi = size - ivec2(1);

	vec3 Pl = worldAt(clamp(pix + ivec2(-1, 0), lo, hi), invSize);
	vec3 Pr = worldAt(clamp(pix + ivec2( 1, 0), lo, hi), invSize);
	vec3 Pd = worldAt(clamp(pix + ivec2( 0,-1), lo, hi), invSize);
	vec3 Pu = worldAt(clamp(pix + ivec2( 0, 1), lo, hi), invSize);

	// keep the closer neighbour on each axis; the far one is across an edge
	vec3 dx = (abs(dot(Pr - P, Pr - P)) < abs(dot(P - Pl, P - Pl))) ? (Pr - P) : (P - Pl);
	vec3 dy = (abs(dot(Pu - P, Pu - P)) < abs(dot(P - Pd, P - Pd))) ? (Pu - P) : (P - Pd);

	vec3 N = cross(dx, dy);
	float nlen = length(N);
	if (nlen < 1e-8) {
		// degenerate - every tap landed on the same point. Nothing sensible to
		// trace a hemisphere around, so leave the pixel unoccluded.
		out_color = vec4(1.0);
		return;
	}
	N /= nlen;

	vec3 V = normalize(pc.eye.xyz - P);
	if (dot(N, V) < 0.0) {
		N = -N;
	}

	// orthonormal basis around N
	vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 T = normalize(cross(up, N));
	vec3 B = cross(N, T);

	float radius = pc.params.x;
	float bias = pc.params.w;
	float rot = hash12(gl_FragCoord.xy + pc.params.z) * 6.2831853;

	float occluded = 0.0;

	for (int i = 0; i < sampleCount; i++) {
		/*
		Cosine-weighted hemisphere direction. r = sqrt(u) and z = sqrt(1-u) is
		the concentric-disc mapping: the disc radius grows as sqrt so equal-area
		annuli get equal sample counts, and lifting it onto the hemisphere gives
		the cosine distribution for free, with no rejection loop.
		*/
		float u = (float(i) + 0.5) / float(sampleCount);
		float r = sqrt(u);
		float phi = rot + float(i) * 2.39996323;   // golden angle, so the few
		                                           // samples we have spread out
		vec3 dir = normalize(T * (r * cos(phi)) + B * (r * sin(phi)) + N * sqrt(1.0 - u));

		/*
		Start the ray slightly off the surface. Without the bias a ray leaving a
		triangle re-hits the triangle it started on at t near zero, and every
		pixel returns fully occluded - the classic shadow acne, which in AO
		shows up as the whole world going uniformly dark rather than as stripes.
		*/
		rayQueryEXT rq;
		rayQueryInitializeEXT(rq, topLevel,
			gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
			0xFF, P + N * bias, bias, dir, radius);

		/*
		No candidate handling. Every geometry in the structure was built with
		VK_GEOMETRY_OPAQUE_BIT_KHR and traced with gl_RayFlagsOpaqueEXT, so
		there are no any-hit candidates to resolve and the loop body is empty by
		construction rather than by omission.
		*/
		while (rayQueryProceedEXT(rq)) {}

		if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
			/*
			Nearer occluders matter more. A wall at arm's length darkens a
			corner; the same wall at the far end of the radius barely does.
			Falling off with distance is what stops AO from painting a hard edge
			exactly at the radius, which reads as a ring around the player.
			*/
			float t = rayQueryGetIntersectionTEXT(rq, true);
			occluded += 1.0 - clamp(t / radius, 0.0, 1.0);
		}
	}

	float ao = 1.0 - (occluded / float(sampleCount)) * pc.params.y;
	out_color = vec4(clamp(ao, 0.0, 1.0));
}
